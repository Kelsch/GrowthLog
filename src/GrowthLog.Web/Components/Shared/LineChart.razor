@* Lightweight inline-SVG line chart. No external charting library.
   Renders only actual measurement points — no interpolation. *@

<div class="line-chart @Class">
    @if (Series.Count == 0 || Series.All(s => s.Points.Count == 0))
    {
        <p class="text-muted">No data to chart yet.</p>
    }
    else
    {
        <svg viewBox="0 0 @Width @Height" preserveAspectRatio="xMidYMid meet"
             style="width:100%;height:auto;min-height:360px;max-height:520px;">
            @* Plot area background *@
            <rect x="@PadLeft" y="@PadTop"
                  width="@(Width - PadLeft - PadRight)"
                  height="@(Height - PadTop - PadBottom)"
                  fill="#fbfdff" />

            @* Axes *@
            <line x1="@PadLeft" y1="@(Height - PadBottom)" x2="@(Width - PadRight)" y2="@(Height - PadBottom)"
                  stroke="#94a3b8" stroke-width="1.5" />
            <line x1="@PadLeft" y1="@PadTop" x2="@PadLeft" y2="@(Height - PadBottom)"
                  stroke="#94a3b8" stroke-width="1.5" />

            @* Y gridlines + labels *@
            @foreach (var tick in YTicks)
            {
                var y = YToPixel(tick);
                <line x1="@PadLeft" y1="@y" x2="@(Width - PadRight)" y2="@y"
                      stroke="#e2e8f0" stroke-width="1" />
                @((MarkupString)$"<text x=\"{Fmt(PadLeft - 8)}\" y=\"{Fmt(y + 4)}\" text-anchor=\"end\" font-size=\"12\" fill=\"#334155\">{FormatY(tick)}</text>")
            }

            @* X gridlines + labels *@
            @foreach (var tick in XTicks)
            {
                var x = XToPixel(tick);
                <line x1="@x" y1="@PadTop" x2="@x" y2="@(Height - PadBottom)"
                      stroke="#eef2f7" stroke-width="1" />
                @((MarkupString)$"<text x=\"{Fmt(x)}\" y=\"{Fmt(Height - PadBottom + 18)}\" text-anchor=\"middle\" font-size=\"12\" fill=\"#334155\">{FormatX(tick)}</text>")
            }

            @* Y axis title *@
            @((MarkupString)$"<text x=\"{Fmt(PadLeft - 8)}\" y=\"{Fmt(PadTop - 10)}\" text-anchor=\"end\" font-size=\"12\" font-weight=\"700\" fill=\"#1e293b\">{YAxisLabel}</text>")

            @* X axis title *@
            @((MarkupString)$"<text x=\"{Fmt(PadLeft + (Width - PadLeft - PadRight) / 2)}\" y=\"{Fmt(Height - 8)}\" text-anchor=\"middle\" font-size=\"12\" font-weight=\"700\" fill=\"#1e293b\">{XAxisLabel}</text>")

            @* Series *@
            @foreach (var s in Series)
            {
                var color = ColorFor(s.PersonId);
                var muted = HighlightedPersonId is not null && HighlightedPersonId != s.PersonId;
                // Skip non-positive values so a missing/zero measurement never
                // draws a bogus dive to the baseline. Points are actual
                // measurements only — no interpolation.
                var pts = s.Points.Where(p => p.Y > 0).OrderBy(p => p.X).ToList();
                if (pts.Count > 1)
                {
                    <polyline fill="none" stroke="@color" stroke-width="@(muted ? 2 : 3.5)"
                              stroke-opacity="@(muted ? 0.35 : 1)"
                              stroke-linejoin="round" stroke-linecap="round"
                              points="@PolylinePoints(pts)" />
                }
                @foreach (var p in pts)
                {
                    <circle cx="@XToPixel(p.X)" cy="@YToPixel(p.Y)" r="@(muted ? 3.5 : 5.5)"
                            fill="@color" fill-opacity="@(muted ? 0.45 : 1)"
                            stroke="#ffffff" stroke-width="@(muted ? 1 : 1.5)">
                        <title>@s.PersonName — @p.MeasurementDate: @FormatY(p.Y)</title>
                    </circle>
                }
            }
        </svg>

        <div class="chart-legend">
            @foreach (var s in Series.Where(s => s.Points.Count > 0))
            {
                var isHighlighted = HighlightedPersonId == s.PersonId;
                var isMuted = HighlightedPersonId is not null && !isHighlighted;
                <button type="button"
                        class="legend-item @(isHighlighted ? "legend-item-active" : "") @(isMuted ? "legend-item-muted" : "")"
                        @onclick="() => OnLegendClick.InvokeAsync(s.PersonId)">
                    <span class="legend-swatch" style="background:@ColorFor(s.PersonId)"></span>
                    @s.PersonName
                </button>
            }
        </div>
    }
</div>

@code {
    [Parameter] public IReadOnlyList<GrowthLog.Web.Data.Charts.ChartSeries> Series { get; set; } = new List<GrowthLog.Web.Data.Charts.ChartSeries>();
    [Parameter] public string XAxisMode { get; set; } = GrowthLog.Web.Data.Charts.ChartXAxisModes.Age;
    [Parameter] public string YUnit { get; set; } = "cm";
    /// <summary>"Imperial" or "Metric" — controls how Y values are labeled.</summary>
    [Parameter] public string UnitSystem { get; set; } = "Imperial";
    /// <summary>When set, this person's series is emphasized and others are muted.</summary>
    [Parameter] public string? HighlightedPersonId { get; set; }
    [Parameter] public EventCallback<string> OnLegendClick { get; set; }
    /// <summary>Extra CSS classes applied to the chart wrapper (e.g. "chart-card").</summary>
    [Parameter] public string? Class { get; set; }

    private const double Width = 800;
    private const double Height = 460;
    private const double PadLeft = 64;
    private const double PadRight = 16;
    private const double PadTop = 28;
    private const double PadBottom = 52;

    private double _minX, _maxX, _minY, _maxY;

    protected override void OnParametersSet()
    {
        var allPoints = Series.SelectMany(s => s.Points).ToList();
        if (allPoints.Count == 0)
        {
            _minX = 0; _maxX = 1; _minY = 0; _maxY = 1;
            return;
        }

        _minX = allPoints.Min(p => p.X);
        _maxX = allPoints.Max(p => p.X);
        _minY = allPoints.Min(p => p.Y);
        _maxY = allPoints.Max(p => p.Y);

        if (Math.Abs(_maxX - _minX) < 0.001) { _maxX = _minX + 1; }
        if (Math.Abs(_maxY - _minY) < 0.001) { _maxY = _minY + 1; }

        // Add a little headroom on Y, but never let the floor go negative —
        // height and weight are always non-negative quantities. We keep the
        // floor close to the real minimum so small changes stay visible
        // instead of being flattened against a hard zero baseline.
        var pad = (_maxY - _minY) * 0.08;
        _minY = Math.Max(0, _minY - pad);
        _maxY += pad;
    }

    private double XToPixel(double x)
    {
        var t = (x - _minX) / (_maxX - _minX);
        return PadLeft + t * (Width - PadLeft - PadRight);
    }

    private double YToPixel(double y)
    {
        var t = (y - _minY) / (_maxY - _minY);
        return (Height - PadBottom) - t * (Height - PadTop - PadBottom);
    }

    private string PolylinePoints(IEnumerable<GrowthLog.Web.Data.Charts.ChartPoint> pts)
        => string.Join(" ", pts.Select(p =>
            $"{XToPixel(p.X).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)},{YToPixel(p.Y).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)}"));

    private IEnumerable<double> YTicks
    {
        get
        {
            const int count = 5;
            for (var i = 0; i <= count; i++)
            {
                yield return _minY + (_maxY - _minY) * i / count;
            }
        }
    }

    private IEnumerable<double> XTicks
    {
        get
        {
            const int count = 6;
            for (var i = 0; i <= count; i++)
            {
                yield return _minX + (_maxX - _minX) * i / count;
            }
        }
    }

    private static string Fmt(double v)
        => v.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    private string FormatY(double v)
        => YUnit == "kg"
            ? UnitConverter.FormatWeight(v, UnitSystem)
            : UnitConverter.FormatHeight(v, UnitSystem);

    private string YAxisLabel
        => YUnit == "kg"
            ? (UnitSystem == "Metric" ? "Weight (kg)" : "Weight (lb)")
            : (UnitSystem == "Metric" ? "Height (cm)" : "Height (in)");

    private string XAxisLabel
        => XAxisMode == GrowthLog.Web.Data.Charts.ChartXAxisModes.Age
            ? "Age (years)"
            : "Date";

    private string FormatX(double v)
        => XAxisMode == GrowthLog.Web.Data.Charts.ChartXAxisModes.Age
            ? $"{v:0.#}y"
            : v.ToString("0");

    // Saturated, high-contrast palette. Each color is dark enough to read
    // clearly against the light plot background and distinct from its
    // neighbors so trajectories don't blur together.
    private static readonly string[] Palette =
    {
        "#1d4ed8", "#dc2626", "#15803d", "#b45309", "#7e22ce",
        "#0e7490", "#be185d", "#4d7c0f", "#c2410c", "#4338ca"
    };

    private static string ColorFor(string personId)
    {
        var hash = 0;
        foreach (var c in personId) hash = (hash * 31 + c) & 0x7fffffff;
        return Palette[hash % Palette.Length];
    }
}
