@inherits LayoutComponentBase
@rendermode InteractiveServer

<div class="page">
    <div class="sidebar @(_navOpen ? "sidebar-open" : "")">
        <NavMenu OnNavigate="CloseNav" />
    </div>
    @if (_navOpen)
    {
        <div class="sidebar-backdrop" @onclick="CloseNav"></div>
    }

    <main>
        <div class="top-row px-4">
            <button type="button"
                    class="nav-toggle btn btn-sm btn-outline-secondary"
                    aria-label="@(_navOpen ? "Close navigation" : "Open navigation")"
                    aria-expanded="@_navOpen"
                    @onclick="ToggleNav">
                ☰
            </button>
            <AuthorizeView>
                <Authorized>
                    <span class="me-3">@context.User.Identity?.Name</span>
                    <form method="post" action="/account/logout">
                        <AntiforgeryToken />
                        <button type="submit" class="btn btn-link">Log out</button>
                    </form>
                </Authorized>
                <NotAuthorized>
                    <a href="/account/login">Log in</a>
                </NotAuthorized>
            </AuthorizeView>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

@code {
    private bool _navOpen;

    private void ToggleNav() => _navOpen = !_navOpen;

    private void CloseNav() => _navOpen = false;
}
