<div class="sidebar @(_navOpen ? "sidebar-open" : "")">
    <NavMenu OnNavigate="CloseNav" />
</div>
@if (_navOpen)
{
    <div class="sidebar-backdrop" @onclick="CloseNav"></div>
}

<button type="button"
        class="nav-toggle btn btn-sm btn-outline-secondary"
        aria-label="@(_navOpen ? "Close navigation" : "Open navigation")"
        aria-expanded="@_navOpen"
        @onclick="ToggleNav">
    ☰
</button>

@code {
    private bool _navOpen;

    private void ToggleNav() => _navOpen = !_navOpen;

    private void CloseNav() => _navOpen = false;
}
