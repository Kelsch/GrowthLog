@page "/families/{FamilyId}"
@attribute [Authorize]
@rendermode InteractiveServer

@inject FamilyRepository Families
@inject FamilyMembershipRepository Memberships
@inject PersonRepository People
@inject PersonFamilyMembershipRepository PersonFamilies
@inject MeasurementRepository Measurements
@inject FamilyAuthorizationService Authz
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Nav
@inject UserManager<ApplicationUser> UserManager

<PageTitle>@(_family?.Name ?? "Family") — GrowthLog</PageTitle>

@if (_family is null)
{
    <p>Loading…</p>
}
else if (!_canView)
{
    <div class="alert alert-danger">You do not have access to this family.</div>
}
else
{
    <div class="family-header">
        <div class="family-header-main">
            <h1>@_family.Name</h1>
            <div class="family-header-counts">
                <span>@_adultCount adult@(_adultCount == 1 ? "" : "s")</span>
                <span class="dot">·</span>
                <span>@_childCount child@(_childCount == 1 ? "" : "ren")</span>
            </div>
        </div>
        <div class="family-header-actions">
            @if (_canAdminister)
            {
                <button class="btn btn-sm btn-outline-secondary" @onclick="() => _renaming = !_renaming">
                    Rename
                </button>
            }
            <a class="btn btn-sm btn-outline-secondary" href="settings/sharing">Sharing</a>
        </div>
    </div>

    @if (_renaming && _canAdminister)
    {
        <EditForm Model="_rename" OnValidSubmit="Rename">
            <div class="input-group mb-3">
                <InputText @bind-Value="_rename.Name" class="form-control" />
                <AntiforgeryToken />
                <button type="submit" class="btn btn-primary">Save</button>
                <button type="button" class="btn btn-outline-secondary" @onclick="() => _renaming = false">Cancel</button>
            </div>
        </EditForm>
    }

    <h2>Upcoming measurements</h2>
    <p class="text-muted">Keep track of birthdays and yearly growth measurements.</p>
    @if (_upcoming.Count == 0)
    {
        <p>Everyone is caught up. Your next birthday measurement will appear here automatically.</p>
    }
    else
    {
        <div class="upcoming-list">
            @foreach (var u in _upcoming)
            {
                <UpcomingMeasurementCard
                    PersonId="@u.PersonId"
                    PersonName="@u.PersonName"
                    AgeYears="@u.AgeYears"
                    Birthday="@u.Birthday"
                    Status="@u.Status"
                    StatusText="@u.StatusText"
                    LastMeasurementDate="@u.LastMeasurementDate"
                    OnAddMeasurement="() => OpenDialog(u.PersonId)" />
            }
        </div>
    }

    <h2>People in this family</h2>

    <div class="people-toolbar">
        <div class="people-filters">
            <button class="filter-chip @(_filter == "all" ? "active" : "")" @onclick="(() => SetFilter("all"))">All</button>
            <button class="filter-chip @(_filter == "adults" ? "active" : "")" @onclick="(() => SetFilter("adults"))">Adults</button>
            <button class="filter-chip @(_filter == "children" ? "active" : "")" @onclick="(() => SetFilter("children"))">Children</button>
        </div>
        <div class="people-search">
            <input class="form-control" placeholder="Search people…"
                   value="@_peopleSearch"
                   @oninput="e => _peopleSearch = e.Value?.ToString()" />
        </div>
    </div>

    @if (_filteredPeople.Count == 0)
    {
        <p class="text-muted">No people match this filter.</p>
    }
    else
    {
        <div class="person-list">
            @foreach (var p in _filteredPeople)
            {
                var kind = _kinds.GetValueOrDefault(p.Id, "");
                var latest = _latestByPerson.GetValueOrDefault(p.Id);
                <PersonRow
                    PersonId="@p.Id"
                    PersonName="@p.FullName"
                    MembershipKind="@kind"
                    AgeYears="@AgeFor(p)"
                    BirthdayText="@BirthdayTextFor(p)"
                    LatestHeightText="@UnitConverter.FormatHeight(latest?.HeightCm, _unitSystem)"
                    LatestWeightText="@UnitConverter.FormatWeight(latest?.WeightKg, _unitSystem)"
                    LastMeasuredText="@latest?.MeasurementDate"
                    ShowMore="true"
                    ShowRemove="@_canMutate"
                    OnAddMeasurement="() => OpenDialog(p.Id)"
                    OnRemove="() => RemovePerson(p)" />
            }
        </div>
    }

    @if (_canMutate)
    {
        <AddPersonPanel FamilyId="@FamilyId"
                        UserId="@_userId"
                        CurrentMemberIds="@_people.Select(p => p.Id).ToHashSet()"
                        OnChanged="OnPeopleChanged" />
    }

    @if (_sharedPeople.Count > 0)
    {
        <h2>Shared with this family</h2>
        <p class="text-muted">People from connected families that have granted this family access.</p>
        <div class="person-list">
            @foreach (var p in _sharedPeople)
            {
                <div class="person-row person-row-shared">
                    <div class="person-row-avatar" aria-hidden="true">@(string.IsNullOrWhiteSpace(p.FullName) ? "?" : p.FullName.Trim()[0].ToString().ToUpperInvariant())</div>
                    <div class="person-row-main">
                        <div class="person-row-name">
                            <a href="people/@p.Id">@p.FullName</a>
                            <span class="person-row-origin">from @p.FamilyName</span>
                        </div>
                        <div class="person-row-meta">
                            <span>Birthday @p.DateOfBirth</span>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <h2>Members (users)</h2>
    <table class="table">
        <thead><tr><th>User</th><th>Role</th><th></th></tr></thead>
        <tbody>
            @foreach (var m in _memberships)
            {
                <tr>
                    <td>@m.UserId</td>
                    <td>@m.Role</td>
                    <td>
                        @if (_canAdminister && m.UserId != _userId)
                        {
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => RemoveMember(m)">Remove</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <MeasurementDialog IsOpen="_dialogOpen"
                       Person="_dialogPerson"
                       OnClose="CloseDialog"
                       OnSaved="OnMeasurementSaved" />
}

@code {
    [Parameter] public string FamilyId { get; set; } = string.Empty;

    private Family? _family;
    private List<FamilyMembership> _memberships = new();
    private List<Person> _people = new();
    private List<VisiblePersonRow> _sharedPeople = new();
    private readonly Dictionary<string, string> _kinds = new();
    private Dictionary<string, Measurement> _latestByPerson = new(StringComparer.Ordinal);
    private bool _canView;
    private bool _canMutate;
    private bool _canAdminister;
    private string? _userId;
    private string _unitSystem = "Imperial";
    private bool _renaming;
    private readonly RenameModel _rename = new();

    private string _filter = "all";
    private string? _peopleSearch;

    private void SetFilter(string filter) => _filter = filter;

    private List<UpcomingRow> _upcoming = new();
    private bool _dialogOpen;
    private Person? _dialogPerson;

    private int _adultCount => _kinds.Values.Count(k => k == MembershipKinds.Adult);
    private int _childCount => _kinds.Values.Count(k => k == MembershipKinds.Child);

    private List<Person> _filteredPeople
    {
        get
        {
            IEnumerable<Person> q = _people;

            if (_filter == "adults")
            {
                q = q.Where(p => _kinds.GetValueOrDefault(p.Id) == MembershipKinds.Adult);
            }
            else if (_filter == "children")
            {
                q = q.Where(p => _kinds.GetValueOrDefault(p.Id) == MembershipKinds.Child);
            }

            if (!string.IsNullOrWhiteSpace(_peopleSearch))
            {
                var s = _peopleSearch.Trim();
                q = q.Where(p => p.FullName.Contains(s, StringComparison.OrdinalIgnoreCase));
            }

            return q.OrderBy(p => p.FirstName).ThenBy(p => p.LastName).ToList();
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        _userId = state.User.GetUserId();
        if (_userId is null) return;

        var user = await UserManager.FindByIdAsync(_userId);
        _unitSystem = user?.PreferredUnitSystem ?? "Imperial";

        _family = await Families.GetByIdAsync(FamilyId);
        if (_family is null) return;

        _canView = await Authz.CanViewFamilyAsync(_userId, FamilyId);
        _canMutate = await Authz.CanMutateFamilyAsync(_userId, FamilyId);
        _canAdminister = await Authz.CanAdministerFamilyAsync(_userId, FamilyId);

        if (!_canView) return;

        _rename.Name = _family.Name;
        _memberships = (await Memberships.GetForFamilyAsync(FamilyId)).ToList();

        await ReloadPeopleAsync();
        await LoadUpcomingAsync();
    }

    private async Task ReloadPeopleAsync()
    {
        if (_userId is null) return;

        // Authorization-aware: only returns people the user may see.
        _people = (await People.GetVisibleForUserInFamilyAsync(_userId, FamilyId)).ToList();

        _kinds.Clear();
        foreach (var p in _people)
        {
            var m = await PersonFamilies.GetAsync(p.Id, FamilyId);
            if (m is not null) _kinds[p.Id] = m.MembershipKind;
        }

        // Latest measurement per person (authorization-aware, single query).
        _latestByPerson = (await Measurements.GetLatestForPeopleAsync(_userId, _people.Select(p => p.Id)))
            .ToDictionary(kv => kv.Key, kv => kv.Value, StringComparer.Ordinal);

        // People shared *into* this family from connected source families.
        _sharedPeople = (await People.GetSharedIntoFamilyAsync(_userId, FamilyId)).ToList();
    }

    private async Task LoadUpcomingAsync()
    {
        if (_userId is null) return;

        var today = DateOnly.FromDateTime(DateTime.Today);

        _upcoming = new();
        foreach (var p in _people)
        {
            if (!DateOnly.TryParse(p.DateOfBirth, out var dob)) continue;

            var last = _latestByPerson.GetValueOrDefault(p.Id)?.MeasurementDate;

            var due = MeasurementDueCalculator.Evaluate(dob, last, today);

            if (due.Status == MeasurementDueStatuses.Completed) continue;

            _upcoming.Add(new UpcomingRow
            {
                PersonId = p.Id,
                PersonName = p.FullName,
                AgeYears = AgeCalculator.GetAgeYears(dob, today),
                Birthday = due.NextBirthday,
                Status = due.Status,
                StatusText = due.StatusText,
                LastMeasurementDate = due.LastMeasurementDate,
                SortKey = MeasurementDueCalculator.SortKey(due),
                DaysUntilDue = due.DaysUntilDue
            });
        }

        _upcoming = _upcoming
            .OrderBy(u => u.SortKey)
            .ThenBy(u => u.DaysUntilDue)
            .ThenBy(u => u.PersonName)
            .ToList();
    }

    private double? AgeFor(Person p)
        => DateOnly.TryParse(p.DateOfBirth, out var dob)
            ? AgeCalculator.GetAgeYears(dob, DateOnly.FromDateTime(DateTime.Today))
            : null;

    private string BirthdayTextFor(Person p)
        => DateOnly.TryParse(p.DateOfBirth, out var dob)
            ? dob.ToString("MMM d")
            : p.DateOfBirth;

    private void OpenDialog(string personId)
    {
        var p = _people.FirstOrDefault(x => x.Id == personId);
        if (p is null) return;
        _dialogPerson = p;
        _dialogOpen = true;
    }

    private void CloseDialog()
    {
        _dialogOpen = false;
        _dialogPerson = null;
    }

    private async Task OnMeasurementSaved()
    {
        CloseDialog();
        await ReloadPeopleAsync();
        await LoadUpcomingAsync();
    }

    private async Task OnPeopleChanged()
    {
        await ReloadPeopleAsync();
        await LoadUpcomingAsync();
    }

    private async Task Rename()
    {
        if (!_canAdminister) return;
        await Families.RenameAsync(FamilyId, _rename.Name);
        _family = await Families.GetByIdAsync(FamilyId);
        _renaming = false;
    }

    private async Task RemoveMember(FamilyMembership m)
    {
        if (!_canAdminister) return;
        await Memberships.RemoveAsync(FamilyId, m.UserId);
        _memberships = (await Memberships.GetForFamilyAsync(FamilyId)).ToList();
    }

    private async Task RemovePerson(Person p)
    {
        if (!_canMutate || _userId is null) return;
        await PersonFamilies.DeactivateAsync(p.Id, FamilyId);
        await ReloadPeopleAsync();
        await LoadUpcomingAsync();
    }

    private class UpcomingRow
    {
        public string PersonId { get; set; } = string.Empty;
        public string PersonName { get; set; } = string.Empty;
        public double AgeYears { get; set; }
        public DateOnly Birthday { get; set; }
        public string Status { get; set; } = MeasurementDueStatuses.Upcoming;
        public string StatusText { get; set; } = string.Empty;
        public string? LastMeasurementDate { get; set; }
        public int SortKey { get; set; }
        public int DaysUntilDue { get; set; }
    }

    public class RenameModel { public string Name { get; set; } = string.Empty; }
}
