@page "/families/{FamilyId}"
@attribute [Authorize]
@rendermode InteractiveServer

@inject FamilyRepository Families
@inject FamilyMembershipRepository Memberships
@inject PersonRepository People
@inject PersonFamilyMembershipRepository PersonFamilies
@inject FamilyAuthorizationService Authz
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Nav

<PageTitle>Family — GrowthLog</PageTitle>

@if (_family is null)
{
    <p>Loading…</p>
}
else if (!_canView)
{
    <div class="alert alert-danger">You do not have access to this family.</div>
}
else
{
    <h1>@_family.Name</h1>

    @if (_canAdminister)
    {
        <EditForm Model="_rename" OnValidSubmit="Rename">
            <div class="input-group mb-3">
                <InputText @bind-Value="_rename.Name" class="form-control" />
                <AntiforgeryToken />
                <button type="submit" class="btn btn-outline-secondary">Rename</button>
            </div>
        </EditForm>
    }

    <h2>Upcoming measurements</h2>
    <p class="text-muted">Keep track of birthdays and yearly growth measurements.</p>
    @if (_upcoming.Count == 0)
    {
        <p>Everyone is caught up. Your next birthday measurement will appear here automatically.</p>
    }
    else
    {
        <div class="upcoming-list">
            @foreach (var u in _upcoming)
            {
                <UpcomingMeasurementCard
                    PersonId="@u.PersonId"
                    PersonName="@u.PersonName"
                    AgeYears="@u.AgeYears"
                    Birthday="@u.Birthday"
                    Status="@u.Status"
                    StatusText="@u.StatusText"
                    LastMeasurementDate="@u.LastMeasurementDate"
                    OnAddMeasurement="() => OpenDialog(u.PersonId)" />
            }
        </div>
    }

    <h2>Members (users)</h2>
    <table class="table">
        <thead><tr><th>User</th><th>Role</th><th></th></tr></thead>
        <tbody>
            @foreach (var m in _memberships)
            {
                <tr>
                    <td>@m.UserId</td>
                    <td>@m.Role</td>
                    <td>
                        @if (_canAdminister && m.UserId != _userId)
                        {
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => RemoveMember(m)">Remove</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <h2>People</h2>
    <table class="table">
        <thead><tr><th>Name</th><th>Date of birth</th><th>Kind</th><th></th></tr></thead>
        <tbody>
            @foreach (var p in _people)
            {
                <tr>
                    <td><a href="people/@p.Id">@p.FullName</a></td>
                    <td>@p.DateOfBirth</td>
                    <td>@_kinds.GetValueOrDefault(p.Id, "—")</td>
                    <td>
                        @if (_canMutate)
                        {
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => RemovePerson(p)">Remove from family</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @if (_sharedPeople.Count > 0)
    {
        <h2>Shared with this family</h2>
        <p class="text-muted">People from connected families that have granted this family access.</p>
        <table class="table">
            <thead><tr><th>Name</th><th>Date of birth</th><th>From family</th></tr></thead>
            <tbody>
                @foreach (var p in _sharedPeople)
                {
                    <tr>
                        <td><a href="people/@p.Id">@p.FullName</a></td>
                        <td>@p.DateOfBirth</td>
                        <td>@p.FamilyName</td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <MeasurementDialog IsOpen="_dialogOpen"
                       Person="_dialogPerson"
                       OnClose="CloseDialog"
                       OnSaved="OnMeasurementSaved" />

    @if (_canMutate)
    {
        <h3>Add an existing person</h3>
        <p class="text-muted">
            Link someone who already exists (for example, a relative who is already
            in another family). This does not create a duplicate person record.
        </p>

        <div class="row g-2 mb-2">
            <div class="col-md-6">
                <input class="form-control" placeholder="Search by name…"
                       value="@_searchQuery"
                       @oninput="OnSearchInput" />
            </div>
            <div class="col-md-3">
                <select class="form-select" value="@_existingKind" @onchange="e => _existingKind = e.Value?.ToString() ?? MembershipKinds.Child">
                    @foreach (var k in MembershipKinds.All)
                    {
                        <option value="@k">@k</option>
                    }
                </select>
            </div>
        </div>

        @if (_searchResults.Count == 0)
        {
            <p class="text-muted">No matching people you can see.</p>
        }
        else
        {
            <table class="table">
                <thead><tr><th>Name</th><th>Date of birth</th><th>Already in this family</th><th></th></tr></thead>
                <tbody>
                    @foreach (var p in _searchResults)
                    {
                        var already = _kinds.ContainsKey(p.Id);
                        <tr>
                            <td>@p.FullName</td>
                            <td>@p.DateOfBirth</td>
                            <td>@(already ? "Yes" : "—")</td>
                            <td>
                                <button class="btn btn-sm btn-primary"
                                        disabled="@already"
                                        @onclick="() => AddExistingPerson(p)">
                                    Add to family
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        <h3>Create a new person</h3>
        <EditForm Model="_newPerson" OnValidSubmit="AddPerson">
            <DataAnnotationsValidator />
            <div class="row g-2">
                <div class="col-md-2">
                    <InputText @bind-Value="_newPerson.FirstName" class="form-control" placeholder="First name" />
                </div>
                <div class="col-md-2">
                    <InputText @bind-Value="_newPerson.MiddleName" class="form-control" placeholder="Middle name" />
                </div>
                <div class="col-md-2">
                    <InputText @bind-Value="_newPerson.LastName" class="form-control" placeholder="Last name" />
                </div>
                <div class="col-md-3">
                    <InputDate @bind-Value="_newPerson.DateOfBirth" class="form-control" />
                </div>
                <div class="col-md-2">
                    <InputSelect @bind-Value="_newPerson.MembershipKind" class="form-select">
                        @foreach (var k in MembershipKinds.All)
                        {
                            <option value="@k">@k</option>
                        }
                    </InputSelect>
                </div>
                <div class="col-md-1">
                    <button type="submit" class="btn btn-primary">Add</button>
                </div>
            </div>
        </EditForm>
    }
}

@code {
    [Parameter] public string FamilyId { get; set; } = string.Empty;

    private Family? _family;
    private List<FamilyMembership> _memberships = new();
    private List<Person> _people = new();
    private List<VisiblePersonRow> _sharedPeople = new();
    private readonly Dictionary<string, string> _kinds = new();
    private bool _canView;
    private bool _canMutate;
    private bool _canAdminister;
    private string? _userId;
    private readonly RenameModel _rename = new();
    private readonly NewPersonModel _newPerson = new();

    private string? _searchQuery;
    private string _existingKind = MembershipKinds.Child;
    private List<Person> _searchResults = new();
    private System.Threading.Timer? _searchDebounce;

    private List<UpcomingRow> _upcoming = new();
    private bool _dialogOpen;
    private Person? _dialogPerson;

    protected override async Task OnParametersSetAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        _userId = state.User.GetUserId();
        if (_userId is null) return;

        _family = await Families.GetByIdAsync(FamilyId);
        if (_family is null) return;

        _canView = await Authz.CanViewFamilyAsync(_userId, FamilyId);
        _canMutate = await Authz.CanMutateFamilyAsync(_userId, FamilyId);
        _canAdminister = await Authz.CanAdministerFamilyAsync(_userId, FamilyId);

        if (!_canView) return;

        _rename.Name = _family.Name;
        _memberships = (await Memberships.GetForFamilyAsync(FamilyId)).ToList();
        // Authorization-aware: only returns people the user may see.
        _people = (await People.GetVisibleForUserInFamilyAsync(_userId, FamilyId)).ToList();

        // People shared *into* this family from connected source families.
        // Visible to every member of this family (Owner, Adult, Viewer).
        _sharedPeople = (await People.GetSharedIntoFamilyAsync(_userId, FamilyId)).ToList();

        foreach (var p in _people)
        {
            var m = await PersonFamilies.GetAsync(p.Id, FamilyId);
            if (m is not null) _kinds[p.Id] = m.MembershipKind;
        }

        await LoadUpcomingAsync();
        await RefreshSearchAsync();
    }

    private async Task LoadUpcomingAsync()
    {
        if (_userId is null) return;

        var today = DateOnly.FromDateTime(DateTime.Today);
        var measurements = await Measurements.GetVisibleForUserForPersonAsync(_userId, string.Empty);
        // GetVisibleForUserForPersonAsync with an empty id returns nothing, so
        // load per-person instead (family sizes are small).
        var lastByPerson = new Dictionary<string, string>(StringComparer.Ordinal);
        foreach (var p in _people)
        {
            var ms = await Measurements.GetVisibleForUserForPersonAsync(_userId, p.Id);
            var latest = ms.OrderByDescending(m => m.MeasurementDate).FirstOrDefault();
            if (latest is not null) lastByPerson[p.Id] = latest.MeasurementDate;
        }

        _upcoming = new();
        foreach (var p in _people)
        {
            if (!DateOnly.TryParse(p.DateOfBirth, out var dob)) continue;

            var due = MeasurementDueCalculator.Evaluate(
                dob,
                lastByPerson.TryGetValue(p.Id, out var d) ? d : null,
                today);

            if (due.Status == MeasurementDueStatuses.Completed) continue;

            _upcoming.Add(new UpcomingRow
            {
                PersonId = p.Id,
                PersonName = p.FullName,
                AgeYears = AgeCalculator.GetAgeYears(dob, today),
                Birthday = due.NextBirthday,
                Status = due.Status,
                StatusText = due.StatusText,
                LastMeasurementDate = due.LastMeasurementDate,
                SortKey = MeasurementDueCalculator.SortKey(due),
                DaysUntilDue = due.DaysUntilDue
            });
        }

        _upcoming = _upcoming
            .OrderBy(u => u.SortKey)
            .ThenBy(u => u.DaysUntilDue)
            .ThenBy(u => u.PersonName)
            .ToList();
    }

    private void OpenDialog(string personId)
    {
        var p = _people.FirstOrDefault(x => x.Id == personId);
        if (p is null) return;
        _dialogPerson = p;
        _dialogOpen = true;
    }

    private void CloseDialog()
    {
        _dialogOpen = false;
        _dialogPerson = null;
    }

    private async Task OnMeasurementSaved()
    {
        CloseDialog();
        await LoadUpcomingAsync();
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        _searchQuery = e.Value?.ToString();

        // Debounce so we don't hit the database on every keystroke.
        _searchDebounce?.Dispose();
        _searchDebounce = new System.Threading.Timer(async _ =>
        {
            await InvokeAsync(async () =>
            {
                await RefreshSearchAsync();
                StateHasChanged();
            });
        }, null, 250, System.Threading.Timeout.Infinite);
    }

    private async Task RefreshSearchAsync()
    {
        if (_userId is null || !_canMutate) return;
        _searchResults = (await People.SearchVisibleAsync(_userId, _searchQuery)).ToList();
    }

    private async Task AddExistingPerson(Person p)
    {
        if (!_canMutate || _userId is null) return;

        // Defense in depth: only link people the user is authorized to see.
        var visible = await People.GetVisibleByIdsAsync(_userId, new[] { p.Id });
        if (visible.Count == 0) return;

        // Do not create a duplicate Person row — just add the membership.
        await PersonFamilies.AddOrReactivateAsync(p.Id, FamilyId, _existingKind);

        await ReloadPeopleAsync();
        await RefreshSearchAsync();
    }

    private async Task ReloadPeopleAsync()
    {
        if (_userId is null) return;
        _people = (await People.GetVisibleForUserInFamilyAsync(_userId, FamilyId)).ToList();
        _kinds.Clear();
        foreach (var p in _people)
        {
            var m = await PersonFamilies.GetAsync(p.Id, FamilyId);
            if (m is not null) _kinds[p.Id] = m.MembershipKind;
        }
    }

    private async Task Rename()
    {
        if (!_canAdminister) return;
        await Families.RenameAsync(FamilyId, _rename.Name);
        _family = await Families.GetByIdAsync(FamilyId);
    }

    private async Task RemoveMember(FamilyMembership m)
    {
        if (!_canAdminister) return;
        await Memberships.RemoveAsync(FamilyId, m.UserId);
        _memberships = (await Memberships.GetForFamilyAsync(FamilyId)).ToList();
    }

    private async Task RemovePerson(Person p)
    {
        if (!_canMutate || _userId is null) return;
        await PersonFamilies.DeactivateAsync(p.Id, FamilyId);
        _people = (await People.GetVisibleForUserInFamilyAsync(_userId, FamilyId)).ToList();
    }

    private async Task AddPerson()
    {
        if (!_canMutate) return;

        var person = new Person
        {
            FirstName = _newPerson.FirstName,
            MiddleName = _newPerson.MiddleName,
            LastName = _newPerson.LastName,
            DateOfBirth = _newPerson.DateOfBirth.ToString("yyyy-MM-dd"),
            CreatedByUserId = _userId
        };

        await People.CreateAsync(person);
        await PersonFamilies.AddOrReactivateAsync(person.Id, FamilyId, _newPerson.MembershipKind);

        _newPerson.FirstName = string.Empty;
        _newPerson.MiddleName = null;
        _newPerson.LastName = string.Empty;
        _newPerson.DateOfBirth = DateTime.Today;

        await ReloadPeopleAsync();
        await RefreshSearchAsync();
    }

    private class UpcomingRow
    {
        public string PersonId { get; set; } = string.Empty;
        public string PersonName { get; set; } = string.Empty;
        public double AgeYears { get; set; }
        public DateOnly Birthday { get; set; }
        public string Status { get; set; } = MeasurementDueStatuses.Upcoming;
        public string StatusText { get; set; } = string.Empty;
        public string? LastMeasurementDate { get; set; }
        public int SortKey { get; set; }
        public int DaysUntilDue { get; set; }
    }

    public class RenameModel { public string Name { get; set; } = string.Empty; }

    public class NewPersonModel
    {
        [System.ComponentModel.DataAnnotations.Required]
        public string FirstName { get; set; } = string.Empty;
        public string? MiddleName { get; set; }
        public string? LastName { get; set; }
        public DateTime DateOfBirth { get; set; } = DateTime.Today;
        public string MembershipKind { get; set; } = MembershipKinds.Child;
    }
}
