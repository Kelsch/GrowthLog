@page "/"
@attribute [Authorize]
@rendermode InteractiveServer

@inject FamilyRepository Families
@inject PersonRepository People
@inject MeasurementRepository Measurements
@inject GrowthLog.Web.Data.Charts.ChartDataService Charts
@inject AuthenticationStateProvider AuthState
@inject UserManager<ApplicationUser> UserManager

<PageTitle>Dashboard — GrowthLog</PageTitle>

@if (_loading)
{
    <p>Loading…</p>
}
else
{
    <div class="dashboard-header">
        <div>
            <h1>@Greeting, @_displayName!</h1>
            <p class="text-muted">Track, compare, and celebrate your family's growth.</p>
        </div>
        <div class="dashboard-header-actions">
            <button type="button" class="btn btn-primary" @onclick="OpenAddFromDashboard">
                + Add measurement
            </button>
        </div>
    </div>

    <div class="summary-strip">
        <div class="summary-card">
            <div class="summary-card-value">@_ownFamilies.Count</div>
            <div class="summary-card-label">Famil@(_ownFamilies.Count == 1 ? "y" : "ies")</div>
        </div>
        <div class="summary-card">
            <div class="summary-card-value">@_peopleCount</div>
            <div class="summary-card-label">People</div>
        </div>
        <div class="summary-card">
            <div class="summary-card-value">@_measurementCount</div>
            <div class="summary-card-label">Measurements</div>
        </div>
        <div class="summary-card">
            <div class="summary-card-value">@_yearsTrackingText</div>
            <div class="summary-card-label">Years tracking</div>
        </div>
    </div>

    <div class="dashboard-col-growth">
        <div class="section-header">
            <h2>Family growth</h2>
            <a class="btn btn-sm btn-outline-secondary" href="compare">Open full compare</a>
        </div>

        @if (_ownFamilies.Count > 0)
        {
            <div class="chart-family-chips">
                @foreach (var f in _ownFamilies)
                {
                    <button type="button"
                            class="filter-chip @(_selectedFamilyId == f.Id ? "active" : "")"
                            @onclick="() => SelectFamily(f.Id)">
                        @f.Name
                    </button>
                }
            </div>
        }

        <div class="chart-toolbar">
            <div class="chart-metric-toggle">
                <button type="button"
                        class="filter-chip @(_chartMetric == ChartMetrics.Height ? "active" : "")"
                        @onclick='() => SetMetric(ChartMetrics.Height)'>
                    Height
                </button>
                <button type="button"
                        class="filter-chip @(_chartMetric == ChartMetrics.Weight ? "active" : "")"
                        @onclick='() => SetMetric(ChartMetrics.Weight)'>
                    Weight
                </button>
                <button type="button"
                        class="filter-chip @(_chartMetric == MetricModes.Both ? "active" : "")"
                        @onclick='() => SetMetric(MetricModes.Both)'>
                    Both
                </button>
            </div>

            <div class="chart-range-toggle">
                <button type="button"
                        class="filter-chip @(_chartTab == ChartTabs.ByAge ? "active" : "")"
                        @onclick='() => SetTab(ChartTabs.ByAge)'>
                    By age
                </button>
                <button type="button"
                        class="filter-chip @(_chartTab == ChartTabs.OverTime ? "active" : "")"
                        @onclick='() => SetTab(ChartTabs.OverTime)'>
                    Over time
                </button>
            </div>
        </div>

        @if (_chartTab == ChartTabs.ByAge)
        {
            <div class="same-age-controls mb-3">
                <label class="form-label" for="dash-age-slider">Age (years)</label>
                <div class="same-age-controls-row">
                    <input id="dash-age-slider" type="range"
                           min="@MinAge" max="@MaxAge" step="1"
                           value="@_selectedAge"
                           @oninput="OnAgeSliderChanged" />
                    <input type="number" class="form-control same-age-number"
                           min="@MinAge" max="@MaxAge" step="1"
                           value="@_selectedAge"
                           @oninput="OnAgeNumberChanged" />
                </div>
                <p class="text-muted">Nearest actual measurement within ±6 months of the selected age. Missing values are not interpolated.</p>
            </div>

            @if (_barRows.Count == 0)
            {
                <EmptyState Icon="📊"
                            Title="No measurements to compare yet."
                            Description="Add a measurement for someone in this family to see the comparison." />
            }
            else
            {
                @if (_chartMetric == MetricModes.Both)
                {
                    <div class="both-chart">
                        <div class="both-chart-axis-label both-chart-axis-left">Height (@(_unitSystem == "Metric" ? "cm" : "ft-in"))</div>
                        <div class="both-chart-axis-label both-chart-axis-right">Weight (@(_unitSystem == "Metric" ? "kg" : "lb"))</div>
                        <div class="both-chart-plot">
                            @foreach (var row in _barRows)
                            {
                                <div class="both-chart-col" title="@TooltipFor(row)">
                                    <div class="both-chart-value">@FormatValue(row.HeightValue ?? 0)</div>
                                    <div class="both-chart-track">
                                        <div class="both-chart-bar"
                                             style="height:@(BarHeightPercent(row.HeightValue ?? 0, _barMaxHeight).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%;background:@ColorFor(row.PersonId)">
                                        </div>
                                    </div>
                                    <div class="both-chart-name" title="@row.PersonName">@row.FirstName</div>
                                </div>
                            }
                        </div>
                        @* Weight overlay. The SVG uses a pixel viewBox that matches
                           the plot area (bars only, above the name row) so markers
                           stay circular and the line never crosses the labels.
                           Missing weights are simply omitted (gap in the line). *@
                        <svg class="both-chart-line"
                             viewBox="0 0 @BothPlotWidth @BothPlotHeight"
                             preserveAspectRatio="none">
                            @if (_weightLinePoints.Length > 1)
                            {
                                <polyline fill="none" stroke="#dc2626" stroke-width="2"
                                          stroke-linejoin="round" stroke-linecap="round"
                                          points="@_weightLinePoints" />
                            }
                            @foreach (var pt in _weightLineDots)
                            {
                                <circle cx="@pt.X" cy="@pt.Y" r="5" fill="#dc2626"
                                        stroke="#ffffff" stroke-width="1.5" />
                            }
                        </svg>
                        @* Weight value labels, positioned in the same pixel space
                           as the overlay so they sit just above each marker. *@
                        @foreach (var lbl in _weightLabels)
                        {
                            <span class="both-chart-weight-label"
                                  style="left:@(lbl.LeftPercent.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%;top:@(lbl.TopPercent.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%">
                                @lbl.Text
                            </span>
                        }
                    </div>
                }
                else
                {
                    <div class="vbar-chart">
                        <div class="vbar-plot">
                            @foreach (var row in _barRows)
                            {
                                <div class="vbar-col" title="@TooltipFor(row)">
                                    <div class="vbar-value">@FormatValue(row.Value!.Value)</div>
                                    <div class="vbar-track">
                                        <div class="vbar-bar"
                                             style="height:@(BarHeightPercent(row.Value!.Value, _barMaxValue).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%;background:@ColorFor(row.PersonId)">
                                        </div>
                                    </div>
                                    <div class="vbar-name" title="@row.PersonName">@row.FirstName</div>
                                </div>
                            }
                        </div>
                    </div>
                }

                @if (_missingBarRows.Count > 0)
                {
                    <div class="same-age-missing-section">
                        <h3 class="same-age-missing-heading">No measurement near age @_selectedAge.ToString("0.#")</h3>
                        <ul class="same-age-missing-list">
                            @foreach (var row in _missingBarRows)
                            {
                                <li>@row.PersonName</li>
                            }
                        </ul>
                    </div>
                }
            }
        }
        else
        {
            @if (_snapshotSeries.Count == 0)
            {
                <EmptyState Icon="📈"
                            Title="No growth data to show yet."
                            Description="Add a measurement to see your family's growth over time." />
            }
            else
            {
                <LineChart Series="_snapshotSeries"
                           XAxisMode="Age"
                           Metric="_chartMetric"
                           YUnit="@(_chartMetric == ChartMetrics.Weight ? "kg" : "cm")"
                           UnitSystem="_unitSystem"
                           HighlightedPersonId="_highlightedPersonId"
                           OnLegendClick="OnLegendClick"
                           Class="chart-card" />
            }
        }
    </div>

    <div class="dashboard-two-col">
        <div class="dashboard-col-upcoming">
            <div class="section-header">
                <h2>Upcoming measurements</h2>
                @if (_hasLongTailUpcoming)
                {
                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => _showAllUpcoming = !_showAllUpcoming">
                        @(_showAllUpcoming ? "Show fewer" : "Show all upcoming")
                    </button>
                }
            </div>
            <p class="text-muted">Keep track of birthdays and yearly growth measurements.</p>
            @if (_visibleUpcoming.Count == 0)
            {
                <EmptyState Icon="🎉"
                            Title="Everyone is caught up."
                            Description="Your next birthday measurement will appear here automatically." />
            }
            else
            {
                <div class="upcoming-list">
                    @foreach (var u in _visibleUpcoming)
                    {
                        <UpcomingMeasurementCard
                            PersonId="@u.PersonId"
                            PersonName="@u.PersonName"
                            AgeYears="@u.AgeYears"
                            Birthday="@u.Birthday"
                            Status="@u.Status"
                            StatusText="@u.StatusText"
                            LastMeasurementDate="@u.LastMeasurementDate"
                            OnAddMeasurement="() => OpenDialog(u.PersonId)" />
                    }
                </div>
            }
        </div>

        <div>
            <h2>Recent activity</h2>
            @if (_recent.Count > 0)
            {
                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => _showAllRecent = !_showAllRecent">
                    @(_showAllRecent ? "Show less" : "View all")
                </button>
            }

            @if (_recent.Count == 0)
            {
                <EmptyState Icon="📏"
                            Title="No measurements yet."
                            Description="Add the first height or weight measurement to start a growth history."
                            ActionText="+ Add measurement"
                            OnAction="OpenAddFromDashboard" />
            }
            else if (!_showAllRecent)
            {
                <ul class="activity-feed">
                    @foreach (var r in _recent.Take(5))
                    {
                        <li class="activity-item">
                            <div class="activity-main">
                                <a href="people/@r.PersonId">@r.PersonName</a>
                                <span class="activity-values">
                                    @UnitConverter.FormatHeight(r.HeightCm, _unitSystem)
                                    <span class="dot">·</span>
                                    @UnitConverter.FormatWeight(r.WeightKg, _unitSystem)
                                </span>
                            </div>
                            <div class="activity-when">@RelativeTime(r.MeasurementDate)</div>
                        </li>
                    }
                </ul>
            }
            else
            {
                <table class="table">
                    <thead>
                        <tr><th>Date</th><th>Person</th><th>Height</th><th>Weight</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var r in _recent)
                        {
                            <tr>
                                <td>@r.MeasurementDate</td>
                                <td><a href="people/@r.PersonId">@r.PersonName</a></td>
                                <td>@UnitConverter.FormatHeight(r.HeightCm, _unitSystem)</td>
                                <td>@UnitConverter.FormatWeight(r.WeightKg, _unitSystem)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>

    <h2>My families</h2>
    @if (_ownFamilies.Count == 0)
    {
        <EmptyState Icon="👪"
                    Title="You are not a member of any family yet."
                    Description="Create a family to start tracking growth together."
                    ActionText="Create a family"
                    ActionHref="families" />
    }
    else
    {
        <ul>
            @foreach (var f in _ownFamilies)
            {
                <li><a href="families/@f.Id">@f.Name</a></li>
            }
        </ul>
    }

    @if (_sharedFamilies.Count > 0)
    {
        <h2>Shared with me</h2>
        <ul>
            @foreach (var f in _sharedFamilies)
            {
                <li>@f</li>
            }
        </ul>
    }

    <MeasurementDialog IsOpen="_dialogOpen"
                       Person="_dialogPerson"
                       OnClose="CloseDialog"
                       OnSaved="OnMeasurementSaved" />
}

@code {
    private bool _loading = true;
    private string _unitSystem = "Imperial";
    private string _displayName = "there";
    private List<Family> _ownFamilies = new();
    private List<string> _sharedFamilies = new();
    private List<UpcomingRow> _upcoming = new();
    private List<RecentRow> _recent = new();

    private bool _dialogOpen;
    private Person? _dialogPerson;
    private string? _userId;
    private List<VisiblePersonRow> _visibleRows = new();
    private List<Measurement> _allMeasurements = new();

    private bool _showAllUpcoming;
    private bool _showAllRecent;
    private IReadOnlyList<GrowthLog.Web.Data.Charts.ChartSeries> _snapshotSeries = new List<GrowthLog.Web.Data.Charts.ChartSeries>();

    private const int UpcomingWindowDays = 90;
    private const int SnapshotMaxPeople = 5;
    private const double AgeToleranceYears = 0.5; // ±6 months

    private static class ChartTabs
    {
        public const string ByAge = "ByAge";
        public const string OverTime = "OverTime";
    }

    private static class MetricModes
    {
        public const string Both = "Both";
    }

    private string _chartTab = ChartTabs.ByAge;
    private string _chartMetric = ChartMetrics.Height;
    private string? _selectedFamilyId;
    private string? _defaultFamilyId;
    private string? _highlightedPersonId;
    private double _selectedAge = 10;
    private List<BarRow> _barRows = new();
    private List<BarRow> _missingBarRows = new();
    private double _barMaxValue = 1;
    private double _barMaxHeight = 1;
    private double _barMaxWeight = 1;
    private string _weightLinePoints = string.Empty;
    private List<(double X, double Y)> _weightLineDots = new();
    private List<WeightLabel> _weightLabels = new();

    // Pixel-space dimensions for the weight overlay. These match the CSS
    // height of the plot area (bars only) so markers render as true circles
    // and the line stays above the name row.
    private const double BothPlotWidth = 1000;
    private const double BothPlotHeight = 260;

    private string Greeting
    {
        get
        {
            var hour = DateTime.Now.Hour;
            if (hour < 12) return "Good morning";
            if (hour < 18) return "Good afternoon";
            return "Good evening";
        }
    }

    private int _peopleCount => _visibleRows.Select(r => r.Id).Distinct(StringComparer.Ordinal).Count();

    private int _measurementCount => _allMeasurements.Count;

    private string _yearsTrackingText
    {
        get
        {
            if (_allMeasurements.Count == 0) return "—";

            var dates = _allMeasurements
                .Select(m => DateOnly.TryParse(m.MeasurementDate, out var d) ? d : (DateOnly?)null)
                .Where(d => d is not null)
                .Select(d => d!.Value)
                .ToList();

            if (dates.Count == 0) return "—";

            var earliest = dates.Min();
            var latest = dates.Max();
            var years = (latest.DayNumber - earliest.DayNumber) / 365.25;

            if (years < 1)
            {
                var months = Math.Max(1, (int)Math.Round((latest.DayNumber - earliest.DayNumber) / 30.44));
                return months == 1 ? "1 mo" : $"{months} mo";
            }

            return $"{years:0.#} yr";
        }
    }

    private bool _hasLongTailUpcoming
        => _upcoming.Any(u => u.DaysUntilDue > UpcomingWindowDays);

    private List<UpcomingRow> _visibleUpcoming
        => _showAllUpcoming
            ? _upcoming
            : _upcoming.Where(u => u.DaysUntilDue <= UpcomingWindowDays).ToList();

    private static string RelativeTime(string measurementDate)
    {
        if (!DateOnly.TryParse(measurementDate, out var date))
        {
            return measurementDate;
        }

        var today = DateOnly.FromDateTime(DateTime.Today);
        var days = today.DayNumber - date.DayNumber;

        if (days < 0) return date.ToString("MMM d, yyyy");
        if (days == 0) return "Today";
        if (days == 1) return "Yesterday";
        if (days < 7) return $"{days} days ago";
        if (days < 30) return $"{days / 7} week{(days / 7 == 1 ? "" : "s")} ago";
        if (days < 365) return $"{days / 30} month{(days / 30 == 1 ? "" : "s")} ago";
        return date.ToString("MMM d, yyyy");
    }

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        _userId = state.User.GetUserId();
        if (_userId is null) return;

        var user = await UserManager.FindByIdAsync(_userId);
        _unitSystem = user?.PreferredUnitSystem ?? "Imperial";
        _displayName = ResolveDisplayName(user);
        _defaultFamilyId = user?.DefaultFamilyId;

        await LoadAsync();
        _loading = false;
    }

    private static string ResolveDisplayName(ApplicationUser? user)
    {
        if (user is null) return "there";

        var type = user.GetType();
        var displayNameProp = type.GetProperty("DisplayName");
        var displayName = displayNameProp?.GetValue(user) as string;
        if (!string.IsNullOrWhiteSpace(displayName)) return displayName!;

        if (!string.IsNullOrWhiteSpace(user.UserName)) return user.UserName!;

        if (!string.IsNullOrWhiteSpace(user.Email))
        {
            var at = user.Email.IndexOf('@');
            return at > 0 ? user.Email[..at] : user.Email;
        }

        return "there";
    }

    private async Task LoadAsync()
    {
        if (_userId is null) return;

        _ownFamilies = (await Families.GetForUserAsync(_userId)).ToList();

        _visibleRows = (await People.GetVisiblePeopleWithFamilyAsync(_userId)).ToList();
        _sharedFamilies = _visibleRows.Where(r => r.IsShared)
            .Select(r => r.FamilyName)
            .Distinct()
            .OrderBy(n => n)
            .ToList();

        // Recent measurements (authorization-aware).
        _allMeasurements = (await Measurements.GetVisibleForUserAsync(_userId)).ToList();
        var peopleById = _visibleRows.GroupBy(r => r.Id).ToDictionary(g => g.Key, g => g.First());

        _recent = _allMeasurements
            .OrderByDescending(m => m.MeasurementDate)
            .Take(10)
            .Select(m => new RecentRow
            {
                PersonId = m.PersonId,
                PersonName = peopleById.TryGetValue(m.PersonId, out var p) ? p.FullName : m.PersonId,
                MeasurementDate = m.MeasurementDate,
                HeightCm = m.HeightCm,
                WeightKg = m.WeightKg
            })
            .ToList();

        // Upcoming / due / overdue measurements for every visible person.
        var today = DateOnly.FromDateTime(DateTime.Today);
        var lastByPerson = _allMeasurements
            .GroupBy(m => m.PersonId)
            .ToDictionary(g => g.Key, g => g.OrderByDescending(m => m.MeasurementDate).First().MeasurementDate);

        _upcoming = new();
        foreach (var p in peopleById.Values)
        {
            if (!DateOnly.TryParse(p.DateOfBirth, out var dob)) continue;

            var due = MeasurementDueCalculator.Evaluate(
                dob,
                lastByPerson.TryGetValue(p.Id, out var d) ? d : null,
                today);

            // Only surface people who are not already measured this year.
            if (due.Status == MeasurementDueStatuses.Completed) continue;

            var age = AgeCalculator.GetAgeYears(dob, today);

            _upcoming.Add(new UpcomingRow
            {
                PersonId = p.Id,
                PersonName = p.FullName,
                AgeYears = age,
                Birthday = due.NextBirthday,
                Status = due.Status,
                StatusText = due.StatusText,
                LastMeasurementDate = due.LastMeasurementDate,
                SortKey = MeasurementDueCalculator.SortKey(due),
                DaysUntilDue = due.DaysUntilDue
            });
        }

        _upcoming = _upcoming
            .OrderBy(u => u.SortKey)
            .ThenBy(u => u.DaysUntilDue)
            .ThenBy(u => u.PersonName)
            .ToList();

        // Default to the starred family when set; otherwise the first family.
        if (_selectedFamilyId is null || _ownFamilies.All(f => f.Id != _selectedFamilyId))
        {
            _selectedFamilyId = _defaultFamilyId is not null
                                && _ownFamilies.Any(f => f.Id == _defaultFamilyId)
                ? _defaultFamilyId
                : _ownFamilies.FirstOrDefault()?.Id;
        }

        await LoadChartAsync();
    }

    private async Task LoadChartAsync()
    {
        if (_userId is null) return;

        // People in the selected family, ordered oldest -> youngest by DOB.
        var familyPeople = _visibleRows
            .Where(r => _selectedFamilyId is null || r.FamilyId == _selectedFamilyId)
            .GroupBy(r => r.Id, StringComparer.Ordinal)
            .Select(g => g.First())
            .OrderBy(p => ParseDob(p.DateOfBirth))
            .ToList();

        var personIds = familyPeople.Select(p => p.Id).ToHashSet(StringComparer.Ordinal);

        // The line chart shows a single metric; "Both" falls back to Height.
        var lineMetric = _chartMetric == MetricModes.Both ? ChartMetrics.Height : _chartMetric;

        _snapshotSeries = personIds.Count == 0
            ? new List<GrowthLog.Web.Data.Charts.ChartSeries>()
            : await Charts.GetSeriesAsync(_userId, lineMetric, personIds);

        // Bar chart (by age) — nearest actual measurement within tolerance.
        // For "Both" we need height and weight series separately.
        IReadOnlyList<GrowthLog.Web.Data.Charts.ChartSeries> heightSeries = _snapshotSeries;
        IReadOnlyList<GrowthLog.Web.Data.Charts.ChartSeries> weightSeries = _snapshotSeries;

        if (_chartMetric == MetricModes.Both && personIds.Count > 0)
        {
            heightSeries = await Charts.GetSeriesAsync(_userId, ChartMetrics.Height, personIds);
            weightSeries = await Charts.GetSeriesAsync(_userId, ChartMetrics.Weight, personIds);
        }

        var heightById = heightSeries.ToDictionary(s => s.PersonId, StringComparer.Ordinal);
        var weightById = weightSeries.ToDictionary(s => s.PersonId, StringComparer.Ordinal);

        var rows = new List<BarRow>();
        foreach (var p in familyPeople)
        {
            double? height = NearestValue(heightById, p.Id, _selectedAge);
            double? weight = NearestValue(weightById, p.Id, _selectedAge);

            rows.Add(new BarRow
            {
                PersonId = p.Id,
                PersonName = p.FullName,
                FirstName = p.FirstName,
                Value = _chartMetric == ChartMetrics.Weight ? weight : height,
                HeightValue = height,
                WeightValue = weight
            });
        }

        // Keep oldest -> youngest (familyPeople is already DOB-ordered).
        if (_chartMetric == MetricModes.Both)
        {
            _barRows = rows.Where(r => r.HeightValue is not null || r.WeightValue is not null).ToList();
            _missingBarRows = rows.Where(r => r.HeightValue is null && r.WeightValue is null).ToList();
            _barMaxHeight = _barRows.Select(r => r.HeightValue ?? 0).DefaultIfEmpty(1).Max();
            _barMaxWeight = _barRows.Select(r => r.WeightValue ?? 0).DefaultIfEmpty(1).Max();
            BuildWeightLine();
        }
        else
        {
            _barRows = rows.Where(r => r.Value is not null).ToList();
            _missingBarRows = rows.Where(r => r.Value is null).ToList();
            _barMaxValue = _barRows.Select(r => r.Value!.Value).DefaultIfEmpty(1).Max();
            _weightLinePoints = string.Empty;
            _weightLineDots = new();
        }
    }

    /// <summary>
    /// Builds the weight overlay line for "Both" mode. Coordinates are in a
    /// pixel viewBox matching the plot area (bars only, above the name row):
    /// X is the column center, Y is scaled to the weight axis (0 = top,
    /// BothPlotHeight = baseline). Only actual measurements are plotted, so a
    /// missing weight leaves a gap instead of dropping to the baseline.
    /// </summary>
    private void BuildWeightLine()
    {
        _weightLineDots = new();
        _weightLabels = new();

        var count = _barRows.Count;
        if (count == 0 || _barMaxWeight <= 0)
        {
            _weightLinePoints = string.Empty;
            return;
        }

        var pts = new List<string>();
        for (var i = 0; i < count; i++)
        {
            var row = _barRows[i];
            if (row.WeightValue is null) continue;

            // Column centers: each column occupies 1/count of the width.
            var x = (i + 0.5) * (BothPlotWidth / count);
            var y = BothPlotHeight - (row.WeightValue.Value / _barMaxWeight * BothPlotHeight);
            y = Math.Clamp(y, 0, BothPlotHeight);

            _weightLineDots.Add((x, y));
            pts.Add($"{x.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)},{y.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)}");

            // Label sits just above the marker, in the same pixel space.
            _weightLabels.Add(new WeightLabel
            {
                Text = UnitConverter.FormatWeight(row.WeightValue, _unitSystem),
                LeftPercent = x / BothPlotWidth * 100.0,
                TopPercent = Math.Max(0, (y - 18) / BothPlotHeight * 100.0)
            });
        }

        _weightLinePoints = string.Join(" ", pts);
    }

    private static double? NearestValue(
        IReadOnlyDictionary<string, GrowthLog.Web.Data.Charts.ChartSeries> byId,
        string personId,
        double age)
    {
        if (!byId.TryGetValue(personId, out var s)) return null;
        return s.Points
            .Where(pt => Math.Abs(pt.AgeYears - age) <= AgeToleranceYears)
            .OrderBy(pt => Math.Abs(pt.AgeYears - age))
            .FirstOrDefault()?.Y;
    }

    private static DateOnly ParseDob(string dob)
        => DateOnly.TryParse(dob, out var d) ? d : DateOnly.MaxValue;

    private void OpenAddFromDashboard()
    {
        // Prefer the most urgent upcoming person; otherwise the first visible person.
        var target = _visibleUpcoming.FirstOrDefault()?.PersonId
            ?? _visibleRows.FirstOrDefault()?.Id;

        if (target is null) return;
        OpenDialog(target);
    }

    private void OpenDialog(string personId)
    {
        var row = _visibleRows.FirstOrDefault(r => r.Id == personId);
        if (row is null) return;

        _dialogPerson = new Person
        {
            Id = row.Id,
            FirstName = row.FirstName,
            MiddleName = row.MiddleName,
            LastName = row.LastName,
            DateOfBirth = row.DateOfBirth
        };
        _dialogOpen = true;
    }

    private void CloseDialog()
    {
        _dialogOpen = false;
        _dialogPerson = null;
    }

    private async Task OnMeasurementSaved()
    {
        CloseDialog();
        await LoadAsync();
    }

    private async Task SelectFamily(string familyId)
    {
        _selectedFamilyId = familyId;
        _highlightedPersonId = null;
        await LoadChartAsync();
    }

    private async Task SetMetric(string metric)
    {
        _chartMetric = metric;
        await LoadChartAsync();
    }

    private void SetTab(string tab)
    {
        _chartTab = tab;
    }

    private void OnLegendClick(string personId)
    {
        _highlightedPersonId = _highlightedPersonId == personId ? null : personId;
    }

    private async Task OnAgeSliderChanged(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), out var v))
        {
            _selectedAge = Math.Clamp(v, MinAge, MaxAge);
            await LoadChartAsync();
        }
    }

    private async Task OnAgeNumberChanged(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), out var v))
        {
            _selectedAge = Math.Clamp(v, MinAge, MaxAge);
            await LoadChartAsync();
        }
    }

    private double MinAge => 0;

    private double MaxAge
    {
        get
        {
            var max = _snapshotSeries.SelectMany(s => s.Points)
                .Select(p => p.AgeYears)
                .DefaultIfEmpty(18)
                .Max();
            return Math.Max(1, Math.Ceiling(max));
        }
    }

    private string FormatValue(double v)
        => _chartMetric == ChartMetrics.Weight
            ? UnitConverter.FormatWeight(v, _unitSystem)
            : UnitConverter.FormatHeight(v, _unitSystem);

    private string TooltipFor(BarRow row)
    {
        var age = _selectedAge.ToString("0.#");
        var lines = new List<string> { row.PersonName, $"Age {age}" };

        if (_chartMetric == MetricModes.Both)
        {
            if (row.HeightValue is not null)
                lines.Add($"Height: {UnitConverter.FormatHeight(row.HeightValue, _unitSystem)}");
            if (row.WeightValue is not null)
                lines.Add($"Weight: {UnitConverter.FormatWeight(row.WeightValue, _unitSystem)}");
        }
        else if (row.Value is not null)
        {
            lines.Add(_chartMetric == ChartMetrics.Weight
                ? $"Weight: {UnitConverter.FormatWeight(row.Value, _unitSystem)}"
                : $"Height: {UnitConverter.FormatHeight(row.Value, _unitSystem)}");
        }

        return string.Join("\n", lines);
    }

    private static double BarHeightPercent(double value, double max)
    {
        if (max <= 0) return 0;
        return Math.Max(2, value / max * 100);
    }

    private static readonly string[] Palette =
    {
        "#1d4ed8", "#dc2626", "#15803d", "#b45309", "#7e22ce",
        "#0e7490", "#be185d", "#4d7c0f", "#c2410c", "#4338ca"
    };

    private static string ColorFor(string personId)
    {
        var hash = 0;
        foreach (var c in personId) hash = (hash * 31 + c) & 0x7fffffff;
        return Palette[hash % Palette.Length];
    }

