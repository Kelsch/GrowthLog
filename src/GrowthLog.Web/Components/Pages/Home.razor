@page "/"
@attribute [Authorize]
@rendermode InteractiveServer

@inject FamilyRepository Families
@inject PersonRepository People
@inject MeasurementRepository Measurements
@inject GrowthLog.Web.Data.Charts.ChartDataService Charts
@inject AuthenticationStateProvider AuthState
@inject UserManager<ApplicationUser> UserManager

<PageTitle>Dashboard — GrowthLog</PageTitle>

@if (_loading)
{
    <p>Loading…</p>
}
else
{
    <div class="dashboard-header">
        <div>
            <h1>@Greeting, @_displayName!</h1>
            <p class="text-muted">Track, compare, and celebrate your family's growth.</p>
        </div>
        <div class="dashboard-header-actions">
            <button type="button" class="btn btn-primary" @onclick="OpenAddFromDashboard">
                + Add measurement
            </button>
        </div>
    </div>

    <div class="summary-strip">
        <div class="summary-card">
            <div class="summary-card-value">@_ownFamilies.Count</div>
            <div class="summary-card-label">Famil@(_ownFamilies.Count == 1 ? "y" : "ies")</div>
        </div>
        <div class="summary-card">
            <div class="summary-card-value">@_peopleCount</div>
            <div class="summary-card-label">People</div>
        </div>
        <div class="summary-card">
            <div class="summary-card-value">@_measurementCount</div>
            <div class="summary-card-label">Measurements</div>
        </div>
        <div class="summary-card">
            <div class="summary-card-value">@_yearsTrackingText</div>
            <div class="summary-card-label">Years tracking</div>
        </div>
    </div>

    <div class="section-header">
        <h2>Upcoming measurements</h2>
        @if (_hasLongTailUpcoming)
        {
            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => _showAllUpcoming = !_showAllUpcoming">
                @(_showAllUpcoming ? "Show fewer" : "Show all upcoming")
            </button>
        }
    </div>
    <p class="text-muted">Keep track of birthdays and yearly growth measurements.</p>
    @if (_visibleUpcoming.Count == 0)
    {
        <EmptyState Icon="🎉"
                    Title="Everyone is caught up."
                    Description="Your next birthday measurement will appear here automatically." />
    }
    else
    {
        <div class="upcoming-list">
            @foreach (var u in _visibleUpcoming)
            {
                <UpcomingMeasurementCard
                    PersonId="@u.PersonId"
                    PersonName="@u.PersonName"
                    AgeYears="@u.AgeYears"
                    Birthday="@u.Birthday"
                    Status="@u.Status"
                    StatusText="@u.StatusText"
                    LastMeasurementDate="@u.LastMeasurementDate"
                    OnAddMeasurement="() => OpenDialog(u.PersonId)" />
            }
        </div>
    }

    <div class="section-header">
        <h2>Recent activity</h2>
        @if (_recent.Count > 0)
        {
            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => _showAllRecent = !_showAllRecent">
                @(_showAllRecent ? "Show less" : "View all")
            </button>
        }
    </div>
    @if (_recent.Count == 0)
    {
        <EmptyState Icon="📏"
                    Title="No measurements yet."
                    Description="Add the first height or weight measurement to start a growth history."
                    ActionText="+ Add measurement"
                    OnAction="OpenAddFromDashboard" />
    }
    else if (!_showAllRecent)
    {
        <ul class="activity-feed">
            @foreach (var r in _recent.Take(8))
            {
                <li class="activity-item">
                    <div class="activity-main">
                        <a href="people/@r.PersonId">@r.PersonName</a>
                        <span class="activity-values">
                            @UnitConverter.FormatHeight(r.HeightCm, _unitSystem)
                            <span class="dot">·</span>
                            @UnitConverter.FormatWeight(r.WeightKg, _unitSystem)
                        </span>
                    </div>
                    <div class="activity-when">@RelativeTime(r.MeasurementDate)</div>
                </li>
            }
        </ul>
    }
    else
    {
        <table class="table">
            <thead>
                <tr><th>Date</th><th>Person</th><th>Height</th><th>Weight</th></tr>
            </thead>
            <tbody>
                @foreach (var r in _recent)
                {
                    <tr>
                        <td>@r.MeasurementDate</td>
                        <td><a href="people/@r.PersonId">@r.PersonName</a></td>
                        <td>@UnitConverter.FormatHeight(r.HeightCm, _unitSystem)</td>
                        <td>@UnitConverter.FormatWeight(r.WeightKg, _unitSystem)</td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <h2>My families</h2>
    @if (_ownFamilies.Count == 0)
    {
        <EmptyState Icon="👪"
                    Title="You are not a member of any family yet."
                    Description="Create a family to start tracking growth together."
                    ActionText="Create a family"
                    ActionHref="families" />
    }
    else
    {
        <ul>
            @foreach (var f in _ownFamilies)
            {
                <li><a href="families/@f.Id">@f.Name</a></li>
            }
        </ul>
    }

    @if (_sharedFamilies.Count > 0)
    {
        <h2>Shared with me</h2>
        <ul>
            @foreach (var f in _sharedFamilies)
            {
                <li>@f</li>
            }
        </ul>
    }

    <div class="section-header">
        <h2>Family growth</h2>
        <a class="btn btn-sm btn-outline-secondary" href="compare">Open full compare</a>
    </div>
    @if (_snapshotSeries.Count == 0)
    {
        <EmptyState Icon="📈"
                    Title="No growth data to show yet."
                    Description="Add a measurement to see your family's growth over time." />
    }
    else
    {
        <LineChart Series="_snapshotSeries"
                   XAxisMode="Age"
                   YUnit="cm"
                   UnitSystem="_unitSystem" />
    }

    <MeasurementDialog IsOpen="_dialogOpen"
                       Person="_dialogPerson"
                       OnClose="CloseDialog"
                       OnSaved="OnMeasurementSaved" />
}

@code {
    private bool _loading = true;
    private string _unitSystem = "Imperial";
    private string _displayName = "there";
    private List<Family> _ownFamilies = new();
    private List<string> _sharedFamilies = new();
    private List<UpcomingRow> _upcoming = new();
    private List<RecentRow> _recent = new();

    private bool _dialogOpen;
    private Person? _dialogPerson;
    private string? _userId;
    private List<VisiblePersonRow> _visibleRows = new();
    private List<Measurement> _allMeasurements = new();

    private bool _showAllUpcoming;
    private bool _showAllRecent;
    private IReadOnlyList<GrowthLog.Web.Data.Charts.ChartSeries> _snapshotSeries = new List<GrowthLog.Web.Data.Charts.ChartSeries>();

    private const int UpcomingWindowDays = 90;
    private const int SnapshotMaxPeople = 5;

    private string Greeting
    {
        get
        {
            var hour = DateTime.Now.Hour;
            if (hour < 12) return "Good morning";
            if (hour < 18) return "Good afternoon";
            return "Good evening";
        }
    }

    private int _peopleCount => _visibleRows.Select(r => r.Id).Distinct(StringComparer.Ordinal).Count();

    private int _measurementCount => _allMeasurements.Count;

    private string _yearsTrackingText
    {
        get
        {
            if (_allMeasurements.Count == 0) return "—";

            var dates = _allMeasurements
                .Select(m => DateOnly.TryParse(m.MeasurementDate, out var d) ? d : (DateOnly?)null)
                .Where(d => d is not null)
                .Select(d => d!.Value)
                .ToList();

            if (dates.Count == 0) return "—";

            var earliest = dates.Min();
            var latest = dates.Max();
            var years = (latest.DayNumber - earliest.DayNumber) / 365.25;

            if (years < 1)
            {
                var months = Math.Max(1, (int)Math.Round((latest.DayNumber - earliest.DayNumber) / 30.44));
                return months == 1 ? "1 mo" : $"{months} mo";
            }

            return $"{years:0.#} yr";
        }
    }

    private bool _hasLongTailUpcoming
        => _upcoming.Any(u => u.DaysUntilDue > UpcomingWindowDays);

    private List<UpcomingRow> _visibleUpcoming
        => _showAllUpcoming
            ? _upcoming
            : _upcoming.Where(u => u.DaysUntilDue <= UpcomingWindowDays).ToList();

    private static string RelativeTime(string measurementDate)
    {
        if (!DateOnly.TryParse(measurementDate, out var date))
        {
            return measurementDate;
        }

        var today = DateOnly.FromDateTime(DateTime.Today);
        var days = today.DayNumber - date.DayNumber;

        if (days < 0) return date.ToString("MMM d, yyyy");
        if (days == 0) return "Today";
        if (days == 1) return "Yesterday";
        if (days < 7) return $"{days} days ago";
        if (days < 30) return $"{days / 7} week{(days / 7 == 1 ? "" : "s")} ago";
        if (days < 365) return $"{days / 30} month{(days / 30 == 1 ? "" : "s")} ago";
        return date.ToString("MMM d, yyyy");
    }

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        _userId = state.User.GetUserId();
        if (_userId is null) return;

        var user = await UserManager.FindByIdAsync(_userId);
        _unitSystem = user?.PreferredUnitSystem ?? "Imperial";
        _displayName = ResolveDisplayName(user);

        await LoadAsync();
        _loading = false;
    }

    private static string ResolveDisplayName(ApplicationUser? user)
    {
        if (user is null) return "there";

        var type = user.GetType();
        var displayNameProp = type.GetProperty("DisplayName");
        var displayName = displayNameProp?.GetValue(user) as string;
        if (!string.IsNullOrWhiteSpace(displayName)) return displayName!;

        if (!string.IsNullOrWhiteSpace(user.UserName)) return user.UserName!;

        if (!string.IsNullOrWhiteSpace(user.Email))
        {
            var at = user.Email.IndexOf('@');
            return at > 0 ? user.Email[..at] : user.Email;
        }

        return "there";
    }

    private async Task LoadAsync()
    {
        if (_userId is null) return;

        _ownFamilies = (await Families.GetForUserAsync(_userId)).ToList();

        _visibleRows = (await People.GetVisiblePeopleWithFamilyAsync(_userId)).ToList();
        _sharedFamilies = _visibleRows.Where(r => r.IsShared)
            .Select(r => r.FamilyName)
            .Distinct()
            .OrderBy(n => n)
            .ToList();

        // Recent measurements (authorization-aware).
        _allMeasurements = (await Measurements.GetVisibleForUserAsync(_userId)).ToList();
        var peopleById = _visibleRows.GroupBy(r => r.Id).ToDictionary(g => g.Key, g => g.First());

        _recent = _allMeasurements
            .OrderByDescending(m => m.MeasurementDate)
            .Take(10)
            .Select(m => new RecentRow
            {
                PersonId = m.PersonId,
                PersonName = peopleById.TryGetValue(m.PersonId, out var p) ? p.FullName : m.PersonId,
                MeasurementDate = m.MeasurementDate,
                HeightCm = m.HeightCm,
                WeightKg = m.WeightKg
            })
            .ToList();

        // Upcoming / due / overdue measurements for every visible person.
        var today = DateOnly.FromDateTime(DateTime.Today);
        var lastByPerson = _allMeasurements
            .GroupBy(m => m.PersonId)
            .ToDictionary(g => g.Key, g => g.OrderByDescending(m => m.MeasurementDate).First().MeasurementDate);

        _upcoming = new();
        foreach (var p in peopleById.Values)
        {
            if (!DateOnly.TryParse(p.DateOfBirth, out var dob)) continue;

            var due = MeasurementDueCalculator.Evaluate(
                dob,
                lastByPerson.TryGetValue(p.Id, out var d) ? d : null,
                today);

            // Only surface people who are not already measured this year.
            if (due.Status == MeasurementDueStatuses.Completed) continue;

            var age = AgeCalculator.GetAgeYears(dob, today);

            _upcoming.Add(new UpcomingRow
            {
                PersonId = p.Id,
                PersonName = p.FullName,
                AgeYears = age,
                Birthday = due.NextBirthday,
                Status = due.Status,
                StatusText = due.StatusText,
                LastMeasurementDate = due.LastMeasurementDate,
                SortKey = MeasurementDueCalculator.SortKey(due),
                DaysUntilDue = due.DaysUntilDue
            });
        }

        _upcoming = _upcoming
            .OrderBy(u => u.SortKey)
            .ThenBy(u => u.DaysUntilDue)
            .ThenBy(u => u.PersonName)
            .ToList();

        // Read-only growth snapshot: a small default set (first few visible
        // people) so the dashboard card stays uncluttered. Authorization is
        // enforced inside ChartDataService.
        var snapshotIds = peopleById.Values
            .Select(p => p.Id)
            .Take(SnapshotMaxPeople)
            .ToHashSet(StringComparer.Ordinal);

        _snapshotSeries = snapshotIds.Count == 0
            ? new List<GrowthLog.Web.Data.Charts.ChartSeries>()
            : await Charts.GetSeriesAsync(_userId, GrowthLog.Web.Data.Charts.ChartMetrics.Height, snapshotIds);
    }

    private void OpenAddFromDashboard()
    {
        // Prefer the most urgent upcoming person; otherwise the first visible person.
        var target = _visibleUpcoming.FirstOrDefault()?.PersonId
            ?? _visibleRows.FirstOrDefault()?.Id;

        if (target is null) return;
        OpenDialog(target);
    }

    private void OpenDialog(string personId)
    {
        var row = _visibleRows.FirstOrDefault(r => r.Id == personId);
        if (row is null) return;

        _dialogPerson = new Person
        {
            Id = row.Id,
            FirstName = row.FirstName,
            MiddleName = row.MiddleName,
            LastName = row.LastName,
            DateOfBirth = row.DateOfBirth
        };
        _dialogOpen = true;
    }

    private void CloseDialog()
    {
        _dialogOpen = false;
        _dialogPerson = null;
    }

    private async Task OnMeasurementSaved()
    {
        CloseDialog();
        await LoadAsync();
    }

    private class UpcomingRow
    {
        public string PersonId { get; set; } = string.Empty;
        public string PersonName { get; set; } = string.Empty;
        public double AgeYears { get; set; }
        public DateOnly Birthday { get; set; }
        public string Status { get; set; } = MeasurementDueStatuses.Upcoming;
        public string StatusText { get; set; } = string.Empty;
        public string? LastMeasurementDate { get; set; }
        public int SortKey { get; set; }
        public int DaysUntilDue { get; set; }
    }

    private class RecentRow
    {
        public string PersonId { get; set; } = string.Empty;
        public string PersonName { get; set; } = string.Empty;
        public string MeasurementDate { get; set; } = string.Empty;
        public double? HeightCm { get; set; }
        public double? WeightKg { get; set; }
    }
}
