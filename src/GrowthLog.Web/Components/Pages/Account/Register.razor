@page "/account/register"
@layout AccountLayout

@rendermode InteractiveServer

<PageTitle>Register — GrowthLog</PageTitle>

<h1>Create an account</h1>

@if (!string.IsNullOrEmpty(Error))
{
    <div class="alert alert-danger">@Error</div>
}

<form method="post" action="/account/register">
    <AntiforgeryToken />
    <div class="mb-3">
        <label class="form-label" for="displayName">Display name</label>
        <input id="displayName" name="displayName" class="form-control" required />
    </div>
    <div class="mb-3">
        <label class="form-label" for="email">Email</label>
        <input id="email" name="email" type="email" class="form-control" required />
    </div>
    <div class="mb-3">
        <label class="form-label" for="password">Password</label>
        <input id="password" name="password" type="password" class="form-control" required minlength="8" />
    </div>

    <button type="submit" class="btn btn-primary">Register</button>
</form>

<p class="mt-3"><a href="account/login">Already have an account? Log in</a></p>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    private string? Error { get; set; }
}
