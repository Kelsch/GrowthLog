@page "/account/forgot-password"
@layout AccountLayout
@inject UserManager<ApplicationUser> UserManager

<PageTitle>Forgot password — GrowthLog</PageTitle>

<h1>Forgot password</h1>

@if (_sent)
{
    <div class="alert alert-info">
        If an account exists for that email, a reset link has been generated.
        In development, the link is shown below.
    </div>
    @if (!string.IsNullOrEmpty(_devLink))
    {
        <p><a href="@_devLink">@_devLink</a></p>
    }
}
else
{
    <EditForm Model="_model" OnValidSubmit="HandleSubmit">
        <DataAnnotationsValidator />
        <div class="mb-3">
            <label class="form-label">Email</label>
            <InputText @bind-Value="_model.Email" class="form-control" />
        </div>
        <button type="submit" class="btn btn-primary">Send reset link</button>
    </EditForm>
}

@code {
    private readonly ForgotModel _model = new();
    private bool _sent;
    private string? _devLink;

    private async Task HandleSubmit()
    {
        var user = await UserManager.FindByEmailAsync(_model.Email);
        if (user is not null)
        {
            var token = await UserManager.GeneratePasswordResetTokenAsync(user);
            var encoded = Uri.EscapeDataString(token);
            _devLink = $"/account/reset-password?email={Uri.EscapeDataString(_model.Email)}&token={encoded}";
        }
        _sent = true;
    }

    public class ForgotModel
    {
        [System.ComponentModel.DataAnnotations.Required]
        [System.ComponentModel.DataAnnotations.EmailAddress]
        public string Email { get; set; } = string.Empty;
    }
}
