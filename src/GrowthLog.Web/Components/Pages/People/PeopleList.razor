@page "/people"
@attribute [Authorize]
@inject FamilyRepository Families
@inject PersonRepository People
@inject AuthenticationStateProvider AuthState

<PageTitle>People — GrowthLog</PageTitle>

<h1>People</h1>

@if (_rows is null)
{
    <p>Loading…</p>
}
else if (_rows.Count == 0)
{
    <p>No people yet. Create a family and add people to it.</p>
}
else
{
    @if (_ownFamilies.Count > 0)
    {
        <h2>My families</h2>
        @foreach (var (familyName, people) in _ownFamilies)
        {
            <h3>@familyName</h3>
            <ul>
                @foreach (var p in people)
                {
                    <li><a href="people/@p.Id">@p.FullName</a> — born @p.DateOfBirth</li>
                }
            </ul>
        }
    }

    @if (_sharedFamilies.Count > 0)
    {
        <h2>Shared with me</h2>
        @foreach (var (familyName, people) in _sharedFamilies)
        {
            <h3>@familyName</h3>
            <ul>
                @foreach (var p in people)
                {
                    <li><a href="people/@p.Id">@p.FullName</a> — born @p.DateOfBirth</li>
                }
            </ul>
        }
    }
}

@code {
    private List<VisiblePersonRow>? _rows;
    private List<(string FamilyName, List<VisiblePersonRow> People)> _ownFamilies = new();
    private List<(string FamilyName, List<VisiblePersonRow> People)> _sharedFamilies = new();

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        var userId = state.User.GetUserId();
        if (userId is null) return;

        // Authorization-aware: returns own-family people plus people shared
        // with any family the user belongs to (via FamilyConnection +
        // SharingPermission). Works for Owner, Adult, and Viewer roles.
        _rows = (await People.GetVisiblePeopleWithFamilyAsync(userId)).ToList();

        _ownFamilies = _rows
            .Where(r => !r.IsShared)
            .GroupBy(r => r.FamilyName)
            .Select(g => (g.Key, g.ToList()))
            .ToList();

        _sharedFamilies = _rows
            .Where(r => r.IsShared)
            .GroupBy(r => r.FamilyName)
            .Select(g => (g.Key, g.ToList()))
            .ToList();
    }
}
