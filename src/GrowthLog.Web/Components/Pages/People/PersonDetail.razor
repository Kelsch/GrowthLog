@page "/people/{PersonId}"
@attribute [Authorize]
@rendermode InteractiveServer

@inject PersonRepository People
@inject PersonFamilyMembershipRepository PersonFamilies
@inject FamilyRepository Families
@inject RelationshipRepository Relationships
@inject MeasurementRepository Measurements
@inject AuditRepository Audit
@inject FamilyAuthorizationService Authz
@inject GrowthLog.Web.Data.Charts.ChartDataService Charts
@inject AuthenticationStateProvider AuthState
@inject UserManager<ApplicationUser> UserManager

<PageTitle>Person — GrowthLog</PageTitle>

@if (_person is null)
{
    <p>Loading…</p>
}
else if (!_canView)
{
    <div class="alert alert-danger">You do not have access to this person.</div>
}
else
{
    <div class="person-header">
        <div class="person-header-avatar" aria-hidden="true">@Initial</div>
        <div class="person-header-main">
            <h1>@_person.FullName</h1>
            <div class="person-header-meta">
                @if (_dateOfBirth is not null)
                {
                    <span>Age @AgeCalculator.FormatAge(_dateOfBirth.Value, DateOnly.FromDateTime(DateTime.Today))</span>
                    <span class="dot">·</span>
                }
                <span>Born @_person.DateOfBirth</span>
                @if (_primaryFamilyName is not null)
                {
                    <span class="dot">·</span>
                    <span>@_primaryFamilyName</span>
                }
            </div>
        </div>
        <div class="person-header-actions">
            @if (_canMutate)
            {
                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => _editingPerson = !_editingPerson">
                    Edit person
                </button>
                <button type="button" class="btn btn-sm btn-primary" @onclick="OpenAddDialog">
                    + Add measurement
                </button>
            }
        </div>
    </div>

    @if (_editingPerson && _canMutate)
    {
        <EditForm Model="_personEdit" OnValidSubmit="SavePerson">
            <DataAnnotationsValidator />
            <div class="row g-2 mb-3">
                <div class="col-md-3">
                    <label class="form-label">First name</label>
                    <InputText @bind-Value="_personEdit.FirstName" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Middle name</label>
                    <InputText @bind-Value="_personEdit.MiddleName" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Last name</label>
                    <InputText @bind-Value="_personEdit.LastName" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Date of birth</label>
                    <InputDate @bind-Value="_personEdit.DateOfBirth" class="form-control" />
                </div>
            </div>
            <div class="mb-3">
                <AntiforgeryToken />
                <button type="submit" class="btn btn-primary">Save</button>
                <button type="button" class="btn btn-outline-secondary" @onclick="() => _editingPerson = false">Cancel</button>
            </div>
        </EditForm>
    }

    <div class="metric-cards">
        <div class="metric-card">
            <div class="metric-card-label">Height</div>
            <div class="metric-card-value">@UnitConverter.FormatHeight(_stats?.CurrentHeightCm, _unitSystem)</div>
        </div>
        <div class="metric-card">
            <div class="metric-card-label">Weight</div>
            <div class="metric-card-value">@UnitConverter.FormatWeight(_stats?.CurrentWeightKg, _unitSystem)</div>
        </div>
        <div class="metric-card">
            <div class="metric-card-label">Last measured</div>
            <div class="metric-card-value">@(_latestMeasurementDate ?? "—")</div>
        </div>
    </div>

    <h2>Growth</h2>
    @if (_heightSeries.Count == 0 && _weightSeries.Count == 0)
    {
        <EmptyState Icon="📈"
                    Title="No measurements to chart yet."
                    Description="Add the first height or weight measurement to start a growth history."
                    ActionText="+ Add measurement"
                    OnAction="OpenAddDialog" />
    }
    else
    {
        <div class="chart-toolbar">
            <div class="chart-metric-toggle">
                <button class="filter-chip @(_metric == "height" ? "active" : "")" @onclick='() => SetMetric("height")'>Height</button>
                <button class="filter-chip @(_metric == "weight" ? "active" : "")" @onclick='() => SetMetric("weight")'>Weight</button>
            </div>
            <div class="chart-range-toggle">
                <button class="filter-chip @(_range == "all" ? "active" : "")" @onclick='() => SetRange("all")'>All</button>
                <button class="filter-chip @(_range == "1y" ? "active" : "")" @onclick='() => SetRange("1y")'>1Y</button>
                <button class="filter-chip @(_range == "2y" ? "active" : "")" @onclick='() => SetRange("2y")'>2Y</button>
                <button class="filter-chip @(_range == "5y" ? "active" : "")" @onclick='() => SetRange("5y")'>5Y</button>
            </div>
        </div>

        @if (_metric == "height")
        {
            <LineChart Series="_visibleHeightSeries" XAxisMode="Age" YUnit="cm" />
        }
        else
        {
            <LineChart Series="_visibleWeightSeries" XAxisMode="Age" YUnit="kg" />
        }
    }

    <h2>Families</h2>
    @if (_memberships.Count == 0)
    {
        <p>This person is not in any family.</p>
    }
    else
    {
        <ul>
            @foreach (var m in _memberships)
            {
                var fam = _families.GetValueOrDefault(m.FamilyId);
                <li>
                    @(fam?.Name ?? m.FamilyId) — @m.MembershipKind @(m.IsActive ? "" : "(inactive)")
                    @if (_canMutate && m.IsActive && _mutableFamilyIds.Contains(m.FamilyId))
                    {
                        <button class="btn btn-sm btn-outline-danger ms-2"
                                @onclick="() => RemoveFromFamily(m)">Remove from family</button>
                    }
                </li>
            }
        </ul>
    }

    @if (_canMutate && _addableFamilies.Count > 0)
    {
        <h3>Add to a family</h3>
        <div class="row g-2">
            <div class="col-md-4">
                <select class="form-select" value="@_addFamilyId" @onchange="e => _addFamilyId = e.Value?.ToString()">
                    <option value="">— select family —</option>
                    @foreach (var f in _addableFamilies)
                    {
                        <option value="@f.Id">@f.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <select class="form-select" value="@_addKind" @onchange="e => _addKind = e.Value?.ToString() ?? MembershipKinds.Child">
                    @foreach (var k in MembershipKinds.All)
                    {
                        <option value="@k">@k</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <button class="btn btn-primary" @onclick="AddToFamily">Add</button>
            </div>
        </div>
    }

    <h2>Relationships</h2>
    @if (_relationships.Count == 0)
    {
        <p>No relationships recorded yet.</p>
    }
    else
    {
        <ul>
            @foreach (var r in _relationships)
            {
                <li>
                    @r.RelationshipType:
                    <a href="people/@r.FromPersonId">@r.FromPersonName</a>
                    →
                    <a href="people/@r.ToPersonId">@r.ToPersonName</a>
                </li>
            }
        </ul>
    }

    @if (_stats is not null && _stats.Count > 0)
    {
        <h2>Statistics</h2>
        <ul>
            <li>Measurements: @_stats.Count</li>
            @if (_stats.HeightChangeCm is not null)
            {
                <li>Height change since previous: @(_stats.HeightChangeCm >= 0 ? "+" : "")@_stats.HeightChangeCm.Value.ToString("0.0") cm</li>
            }
            @if (_stats.WeightChangeKg is not null)
            {
                <li>Weight change since previous: @(_stats.WeightChangeKg >= 0 ? "+" : "")@_stats.WeightChangeKg.Value.ToString("0.0") kg</li>
            }
        </ul>
    }

    <h2>Measurement history</h2>

    @if (_measurements.Count == 0)
    {
        <EmptyState Icon="📏"
                    Title="No measurements recorded yet."
                    Description="Add the first height or weight measurement to start a growth history."
                    ActionText="+ Add measurement"
                    OnAction="OpenAddDialog" />
    }
    else
    {
        <table class="table">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Age</th>
                    <th>Height</th>
                    <th>Weight</th>
                    <th>Notes</th>
                    @if (_canMutate)
                    {
                        <th></th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var m in _measurements)
                {
                    <tr>
                        <td>@m.MeasurementDate</td>
                        <td>@FormatMeasurementAge(m)</td>
                        <td>@UnitConverter.FormatHeight(m.HeightCm, _unitSystem)</td>
                        <td>@UnitConverter.FormatWeight(m.WeightKg, _unitSystem)</td>
                        <td>@m.Notes</td>
                        @if (_canMutate)
                        {
                            <td>
                                <button class="btn btn-sm btn-outline-secondary" @onclick="() => OpenEditDialog(m)">Edit</button>
                                @if (_confirmDeleteId == m.Id)
                                {
                                    <span class="confirm-inline">
                                        Delete?
                                        <button class="btn btn-sm btn-danger" @onclick="() => DeleteMeasurement(m)">Yes</button>
                                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => _confirmDeleteId = null">No</button>
                                    </span>
                                }
                                else
                                {
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => _confirmDeleteId = m.Id">Delete</button>
                                }
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    }

    @if (_canMutate)
    {
        <h3>Add relationship</h3>
        <EditForm Model="_newRel" OnValidSubmit="AddRelationship">
            <div class="row g-2">
                <div class="col-md-3">
                    <InputSelect @bind-Value="_newRel.Type" class="form-select">
                        @foreach (var t in RelationshipTypes.All)
                        {
                            <option value="@t">@t</option>
                        }
                    </InputSelect>
                </div>
                <div class="col-md-5">
                    <InputSelect @bind-Value="_newRel.OtherPersonId" class="form-select">
                        <option value="">— select person —</option>
                        @foreach (var p in _candidates)
                        {
                            <option value="@p.Id">@p.FullName</option>
                        }
                    </InputSelect>
                </div>
                <div class="col-md-2">
                    <AntiforgeryToken />
                    <button type="submit" class="btn btn-primary">Add</button>
                </div>
            </div>
        </EditForm>
    }

    <MeasurementDialog IsOpen="_dialogOpen"
                       Person="_person"
                       Existing="_dialogExisting"
                       OnClose="CloseDialog"
                       OnSaved="OnMeasurementSaved" />
}

@code {
    [Parameter] public string PersonId { get; set; } = string.Empty;

    private Person? _person;
    private DateOnly? _dateOfBirth;
    private List<PersonFamilyMembership> _memberships = new();
    private readonly Dictionary<string, Family> _families = new();
    private readonly HashSet<string> _mutableFamilyIds = new(StringComparer.Ordinal);
    private List<Family> _addableFamilies = new();
    private string? _addFamilyId;
    private string _addKind = MembershipKinds.Child;
    private List<PersonRelationshipView> _relationships = new();
    private List<Person> _candidates = new();
    private List<Measurement> _measurements = new();
    private IReadOnlyList<GrowthLog.Web.Data.Charts.ChartSeries> _heightSeries = new List<GrowthLog.Web.Data.Charts.ChartSeries>();
    private IReadOnlyList<GrowthLog.Web.Data.Charts.ChartSeries> _weightSeries = new List<GrowthLog.Web.Data.Charts.ChartSeries>();
    private GrowthStats? _stats;
    private bool _canView;
    private bool _canMutate;
    private string _unitSystem = "Imperial";
    private string? _userId;
    private readonly NewRelationshipModel _newRel = new();

    private string _metric = "height";
    private string _range = "all";
    private bool _editingPerson;
    private bool _dialogOpen;
    private Measurement? _dialogExisting;
    private string? _confirmDeleteId;
    private string? _primaryFamilyName;
    private string? _latestMeasurementDate;
    private readonly PersonEditModel _personEdit = new();

    private string Initial
        => string.IsNullOrWhiteSpace(_person?.FullName)
            ? "?"
            : _person!.FullName.Trim()[0].ToString().ToUpperInvariant();

    private void SetMetric(string metric) => _metric = metric;
    private void SetRange(string range) => _range = range;

    private IReadOnlyList<GrowthLog.Web.Data.Charts.ChartSeries> _visibleHeightSeries
        => ApplyRange(_heightSeries);

    private IReadOnlyList<GrowthLog.Web.Data.Charts.ChartSeries> _visibleWeightSeries
        => ApplyRange(_weightSeries);

    private IReadOnlyList<GrowthLog.Web.Data.Charts.ChartSeries> ApplyRange(
        IReadOnlyList<GrowthLog.Web.Data.Charts.ChartSeries> series)
    {
        if (_range == "all" || _dateOfBirth is null) return series;

        var years = _range switch
        {
            "1y" => 1,
            "2y" => 2,
            "5y" => 5,
            _ => 0
        };
        if (years == 0) return series;

        var maxAge = AgeCalculator.GetAgeYears(_dateOfBirth.Value, DateOnly.FromDateTime(DateTime.Today));
        var minAge = Math.Max(0, maxAge - years);

        return series
            .Select(s => new GrowthLog.Web.Data.Charts.ChartSeries
            {
                PersonId = s.PersonId,
                PersonName = s.PersonName,
                Points = s.Points.Where(p => p.X >= minAge && p.X <= maxAge).ToList()
            })
            .ToList();
    }

    protected override async Task OnParametersSetAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        var userId = state.User.GetUserId();
        if (userId is null) return;
        _userId = userId;

        var user = await UserManager.FindByIdAsync(userId);
        _unitSystem = user?.PreferredUnitSystem ?? "Imperial";

        _person = await People.GetByIdAsync(PersonId);
        if (_person is null) return;

        if (DateOnly.TryParse(_person.DateOfBirth, out var dob))
        {
            _dateOfBirth = dob;
        }

        _personEdit.FirstName = _person.FirstName;
        _personEdit.MiddleName = _person.MiddleName;
        _personEdit.LastName = _person.LastName;
        _personEdit.DateOfBirth = _dateOfBirth?.ToDateTime(TimeOnly.MinValue) ?? DateTime.Today;

        _memberships = (await PersonFamilies.GetForPersonAsync(PersonId)).ToList();

        foreach (var m in _memberships)
        {
            var fam = await Families.GetByIdAsync(m.FamilyId);
            if (fam is not null) _families[m.FamilyId] = fam;
        }

        // Families the user can mutate (Owner/Adult) — used to gate add/remove.
        _mutableFamilyIds.Clear();
        foreach (var f in await Families.GetForUserAsync(userId))
        {
            if (await Authz.CanMutateFamilyAsync(userId, f.Id))
            {
                _mutableFamilyIds.Add(f.Id);
            }
        }

        // Families the person is not already an active member of.
        var activeFamilyIds = _memberships.Where(m => m.IsActive).Select(m => m.FamilyId)
            .ToHashSet(StringComparer.Ordinal);
        _addableFamilies = (await Families.GetForUserAsync(userId))
            .Where(f => _mutableFamilyIds.Contains(f.Id) && !activeFamilyIds.Contains(f.Id))
            .ToList();

        // View if the user can view any family the person belongs to.
        foreach (var m in _memberships.Where(m => m.IsActive))
        {
            if (await Authz.CanViewFamilyAsync(userId, m.FamilyId))
            {
                _canView = true;
                break;
            }
        }

        _canMutate = await Authz.CanMutatePersonAsync(userId, PersonId);
        if (!_canView) return;

        _relationships = (await Relationships.GetViewsForPersonAsync(PersonId)).ToList();
        await ReloadMeasurementsAsync(userId);

        _primaryFamilyName = _memberships
            .Where(m => m.IsActive)
            .Select(m => _families.GetValueOrDefault(m.FamilyId)?.Name)
            .FirstOrDefault(n => !string.IsNullOrWhiteSpace(n));

        // Candidate people: everyone in the families this person belongs to.
        var seen = new HashSet<string> { PersonId };
        _candidates = new();
        foreach (var m in _memberships.Where(m => m.IsActive))
        {
            foreach (var p in await People.GetForFamilyAsync(m.FamilyId))
            {
                if (seen.Add(p.Id)) _candidates.Add(p);
            }
        }
    }

    private async Task ReloadMeasurementsAsync(string userId)
    {
        // Authorization-aware: returns an empty list if the user cannot see this person.
        _measurements = (await Measurements.GetVisibleForUserForPersonAsync(userId, PersonId)).ToList();

        var personIds = new[] { PersonId };
        _heightSeries = await Charts.GetSeriesAsync(userId, GrowthLog.Web.Data.Charts.ChartMetrics.Height, personIds);
        _weightSeries = await Charts.GetSeriesAsync(userId, GrowthLog.Web.Data.Charts.ChartMetrics.Weight, personIds);
        _stats = BuildStats(_measurements);
        _latestMeasurementDate = _measurements
            .OrderByDescending(m => m.MeasurementDate)
            .Select(m => m.MeasurementDate)
            .FirstOrDefault();
    }

    private void OpenAddDialog()
    {
        _dialogExisting = null;
        _dialogOpen = true;
    }

    private void OpenEditDialog(Measurement m)
    {
        _dialogExisting = m;
        _dialogOpen = true;
    }

    private void CloseDialog()
    {
        _dialogOpen = false;
        _dialogExisting = null;
    }

    private async Task OnMeasurementSaved()
    {
        CloseDialog();
        if (_userId is not null)
        {
            await ReloadMeasurementsAsync(_userId);
        }
    }

    private async Task SavePerson()
    {
        if (!_canMutate || _person is null || _userId is null) return;

        _person.FirstName = _personEdit.FirstName;
        _person.MiddleName = _personEdit.MiddleName;
        _person.LastName = _personEdit.LastName;
        _person.DateOfBirth = _personEdit.DateOfBirth.ToString("yyyy-MM-dd");

        await People.UpdateAsync(_person);
        await Audit.WriteAsync(_userId, "PersonEdited", "Person", _person.Id);

        _dateOfBirth = DateOnly.TryParse(_person.DateOfBirth, out var dob) ? dob : null;
        _editingPerson = false;
    }

    private async Task AddToFamily()
    {
        if (!_canMutate || _userId is null || string.IsNullOrEmpty(_addFamilyId)) return;
        if (!_mutableFamilyIds.Contains(_addFamilyId)) return;

        await PersonFamilies.AddOrReactivateAsync(PersonId, _addFamilyId, _addKind);
        await Audit.WriteAsync(_userId, "PersonFamilyMembershipAdded", "Person", PersonId);

        // Reload memberships and the addable list.
        _memberships = (await PersonFamilies.GetForPersonAsync(PersonId)).ToList();
        var activeFamilyIds = _memberships.Where(m => m.IsActive).Select(m => m.FamilyId)
            .ToHashSet(StringComparer.Ordinal);
        _addableFamilies = (await Families.GetForUserAsync(_userId))
            .Where(f => _mutableFamilyIds.Contains(f.Id) && !activeFamilyIds.Contains(f.Id))
            .ToList();
        _addFamilyId = null;
    }

    private async Task RemoveFromFamily(PersonFamilyMembership m)
    {
        if (!_canMutate || _userId is null) return;
        if (!_mutableFamilyIds.Contains(m.FamilyId)) return;

        await PersonFamilies.DeactivateAsync(PersonId, m.FamilyId);
        await Audit.WriteAsync(_userId, "PersonFamilyMembershipRemoved", "Person", PersonId);

        _memberships = (await PersonFamilies.GetForPersonAsync(PersonId)).ToList();
        var activeFamilyIds = _memberships.Where(x => x.IsActive).Select(x => x.FamilyId)
            .ToHashSet(StringComparer.Ordinal);
        _addableFamilies = (await Families.GetForUserAsync(_userId))
            .Where(f => _mutableFamilyIds.Contains(f.Id) && !activeFamilyIds.Contains(f.Id))
            .ToList();
    }

    private async Task AddRelationship()
    {
        if (!_canMutate || string.IsNullOrEmpty(_newRel.OtherPersonId)) return;

        if (_newRel.Type == RelationshipTypes.Parent)
        {
            await Relationships.AddParentChildAsync(PersonId, _newRel.OtherPersonId);
        }
        else
        {
            await Relationships.AddSpouseAsync(PersonId, _newRel.OtherPersonId);
        }

        _relationships = (await Relationships.GetViewsForPersonAsync(PersonId)).ToList();
    }

    private string FormatMeasurementAge(Measurement m)
    {
        if (_dateOfBirth is null || !DateOnly.TryParse(m.MeasurementDate, out var date))
        {
            return "—";
        }

        return AgeCalculator.FormatAge(_dateOfBirth.Value, date);
    }

    private async Task DeleteMeasurement(Measurement m)
    {
        if (!_canMutate || _userId is null) return;

        // Server-side re-check: never trust the UI flag alone.
        if (!await Authz.CanMutateMeasurementAsync(_userId, m.Id)) return;

        await Measurements.SoftDeleteAsync(m.Id);
        await Audit.WriteAsync(_userId, "MeasurementDeleted", "Measurement", m.Id);
        _confirmDeleteId = null;
        await ReloadMeasurementsAsync(_userId);
    }

    private static GrowthStats BuildStats(List<Measurement> measurements)
    {
        var ordered = measurements
            .OrderByDescending(m => m.MeasurementDate)
            .ToList();

        var stats = new GrowthStats { Count = ordered.Count };
        if (ordered.Count == 0) return stats;

        stats.CurrentHeightCm = ordered.FirstOrDefault(m => m.HeightCm is not null)?.HeightCm;
        stats.CurrentWeightKg = ordered.FirstOrDefault(m => m.WeightKg is not null)?.WeightKg;

        var withHeight = ordered.Where(m => m.HeightCm is not null).ToList();
        if (withHeight.Count >= 2)
        {
            stats.HeightChangeCm = withHeight[0].HeightCm - withHeight[1].HeightCm;
        }

        var withWeight = ordered.Where(m => m.WeightKg is not null).ToList();
        if (withWeight.Count >= 2)
        {
            stats.WeightChangeKg = withWeight[0].WeightKg - withWeight[1].WeightKg;
        }

        return stats;
    }

    private class GrowthStats
    {
        public int Count { get; set; }
        public double? CurrentHeightCm { get; set; }
        public double? CurrentWeightKg { get; set; }
        public double? HeightChangeCm { get; set; }
        public double? WeightChangeKg { get; set; }
    }

    public class NewRelationshipModel
    {
        public string Type { get; set; } = RelationshipTypes.Parent;
        public string OtherPersonId { get; set; } = string.Empty;
    }

    public class PersonEditModel
    {
        [System.ComponentModel.DataAnnotations.Required]
        public string FirstName { get; set; } = string.Empty;
        public string? MiddleName { get; set; }
        public string? LastName { get; set; }
        public DateTime DateOfBirth { get; set; } = DateTime.Today;
    }
}
