@page "/settings"
@attribute [Authorize]
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthState

<PageTitle>Settings — GrowthLog</PageTitle>

<h1>Settings</h1>

@if (_user is null)
{
    <p>Loading…</p>
}
else
{
    <h2>Account</h2>
    <EditForm Model="_model" OnValidSubmit="Save">
        <DataAnnotationsValidator />
        <div class="mb-3">
            <label class="form-label">Display name</label>
            <InputText @bind-Value="_model.DisplayName" class="form-control" />
        </div>
        <div class="mb-3">
            <label class="form-label">Email</label>
            <InputText @bind-Value="_model.Email" class="form-control" />
        </div>
        <div class="mb-3">
            <label class="form-label">Preferred units</label>
            <InputSelect @bind-Value="_model.PreferredUnitSystem" class="form-select">
                <option value="Imperial">Imperial (ft/in, lb)</option>
                <option value="Metric">Metric (cm, kg)</option>
            </InputSelect>
        </div>
        <button type="submit" class="btn btn-primary">Save</button>
    </EditForm>

    @if (!string.IsNullOrEmpty(_message))
    {
        <div class="alert alert-info mt-3">@_message</div>
    }
}

@code {
    private ApplicationUser? _user;
    private readonly SettingsModel _model = new();
    private string? _message;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        var userId = state.User.GetUserId();
        if (userId is null) return;

        _user = await UserManager.FindByIdAsync(userId);
        if (_user is null) return;

        _model.DisplayName = _user.DisplayName;
        _model.Email = _user.Email ?? string.Empty;
        _model.PreferredUnitSystem = _user.PreferredUnitSystem;
    }

    private async Task Save()
    {
        if (_user is null) return;

        _user.DisplayName = _model.DisplayName;
        _user.Email = _model.Email;
        _user.UserName = _model.Email;
        _user.PreferredUnitSystem = _model.PreferredUnitSystem;

        var result = await UserManager.UpdateAsync(_user);
        _message = result.Succeeded
            ? "Settings saved."
            : string.Join("; ", result.Errors.Select(e => e.Description));
    }

    public class SettingsModel
    {
        [System.ComponentModel.DataAnnotations.Required]
        public string DisplayName { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required]
        [System.ComponentModel.DataAnnotations.EmailAddress]
        public string Email { get; set; } = string.Empty;

        public string PreferredUnitSystem { get; set; } = "Imperial";
    }
}
