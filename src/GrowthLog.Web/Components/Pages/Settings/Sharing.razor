@page "/settings/sharing"
@attribute [Authorize]
@rendermode InteractiveServer

@inject FamilyRepository Families
@inject FamilyConnectionRepository Connections
@inject SharingPermissionRepository Permissions
@inject FamilyDiscoveryRepository Discovery
@inject FamilyAuthorizationService Authz
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Nav

<PageTitle>Sharing &amp; Privacy — GrowthLog</PageTitle>

<h1>Sharing &amp; Privacy</h1>

<p class="text-muted">
    You share a whole family with another family. People who receive the share
    depend on your connection rules. Membership is managed under
    <a href="families">Families</a>, not here.
</p>

@if (_families is null)
{
    <p>Loading…</p>
}
else if (_families.Count == 0)
{
    <p>You are not a member of any family yet.</p>
}
else
{
    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="alert alert-danger">@_error</div>
    }

    @* ------------------------------------------------------------------
       Section 1 — Existing connections (primary).
       Lists only actual FamilyConnections where the selected source family
       is the Source. A family the user merely belongs to is never listed
       here. Permissions and Disconnect live on each row.
       ------------------------------------------------------------------ *@
    <section class="sharing-section">
        <div class="section-header">
            <h2>Existing connections</h2>
        </div>

        <div class="mb-3">
            <label class="form-label">Share from</label>
            <select class="form-select" value="@_selectedFamilyId" @onchange="OnFamilyChanged">
                @foreach (var f in _ownedFamilies)
                {
                    <option value="@f.Id">@f.Name</option>
                }
            </select>
            <p class="text-muted mt-1 mb-0">
                Choose which of your families owns the data being shared.
                Only families you own can be shared.
            </p>
        </div>

        @if (!_canManage)
        {
            <div class="alert alert-warning">
                Only the family owner can change sharing settings.
            </div>
        }

        @if (_connections.Count == 0)
        {
            <p class="text-muted">
                No connections yet. Use <strong>Share with</strong> below to
                connect this family to another.
            </p>
        }
        else
        {
            <table class="table">
                <thead>
                    <tr>
                        <th>Connection</th>
                        <th>View children</th>
                        <th>View adults</th>
                        <th>View all</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in _connections)
                    {
                        <tr>
                            <td>
                                <div>
                                    Sharing <strong>@_selectedFamilyName</strong>
                                    with <strong>@c.TargetFamilyName</strong>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(c.Label))
                                {
                                    <div class="text-muted small">@c.Label</div>
                                }
                            </td>
                            <td>
                                <input type="checkbox" checked="@c.ViewChildren"
                                       disabled="@(!_canManage)"
                                       @onchange="e => Toggle(c, SharingPermissionKinds.ViewChildren, (bool)e.Value!)" />
                            </td>
                            <td>
                                <input type="checkbox" checked="@c.ViewAdults"
                                       disabled="@(!_canManage)"
                                       @onchange="e => Toggle(c, SharingPermissionKinds.ViewAdults, (bool)e.Value!)" />
                            </td>
                            <td>
                                <input type="checkbox" checked="@c.ViewAll"
                                       disabled="@(!_canManage)"
                                       @onchange="e => Toggle(c, SharingPermissionKinds.ViewAll, (bool)e.Value!)" />
                            </td>
                            <td>
                                @if (_canManage)
                                {
                                    <button class="btn btn-sm btn-outline-danger"
                                            @onclick="() => RemoveConnection(c)">Disconnect</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>

    @* ------------------------------------------------------------------
       Section 2 — Share with (new connection only).
       Eligible targets come from the co-member discovery rules. We exclude:
         * the selected source family itself
         * families already connected to the selected source (either
           direction), so the list only shows genuinely new options
       ------------------------------------------------------------------ *@
    @if (_canManage)
    {
        <section class="sharing-section">
            <div class="section-header">
                <h2>Share with</h2>
            </div>

            <p class="text-muted">
                You can only connect to families owned by people who already
                share at least one family membership with you. GrowthLog never
                lists families you have no relationship with.
            </p>

            @if (_coMembers.Count == 0)
            {
                <p class="text-muted">No co-members found.</p>
            }
            else
            {
                <div class="row g-2 mb-3">
                    <div class="col-md-6">
                        <label class="form-label">Person you share a family with</label>
                        <select class="form-select" value="@_selectedCoMemberId" @onchange="OnCoMemberChanged">
                            <option value="">— select person —</option>
                            @foreach (var cm in _coMembers)
                            {
                                <option value="@cm.UserId">
                                    @(string.IsNullOrWhiteSpace(cm.DisplayName) ? cm.Email : cm.DisplayName)
                                    @(string.IsNullOrWhiteSpace(cm.SharedFamilyNames) ? "" : $" (via {cm.SharedFamilyNames})")
                                </option>
                            }
                        </select>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(_selectedCoMemberId))
                {
                    @if (_availableTargets.Count == 0)
                    {
                        <div class="alert alert-secondary">
                            <strong>No families available to connect.</strong>
                            <div class="small mt-1">
                                This person has no families you can connect to.
                                You may already be a member of them, or a
                                connection already exists between your selected
                                source family and theirs.
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="row g-2">
                            <div class="col-md-4">
                                <label class="form-label">Share my family</label>
                                <select class="form-select" value="@_connectSourceFamilyId" @onchange="OnConnectSourceChanged">
                                    <option value="">— select my family —</option>
                                    @foreach (var f in _ownedFamilies)
                                    {
                                        <option value="@f.Id">@f.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">With their family</label>
                                <select class="form-select" value="@_connectTargetFamilyId" @onchange="OnConnectTargetChanged">
                                    <option value="">— select their family —</option>
                                    @foreach (var f in _availableTargets)
                                    {
                                        <option value="@f.FamilyId">@f.FamilyName</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-4 d-flex align-items-end">
                                <button type="button" class="btn btn-primary"
                                        disabled="@(!CanCreateCoMemberConnection)"
                                        @onclick="CreateCoMemberConnection">
                                    Connect
                                </button>
                            </div>
                        </div>
                        <p class="text-muted mt-2">
                            This creates a connection from <strong>your family</strong>
                            (the source that owns the data) to <strong>their family</strong>
                            (the target that receives visibility). No data is shared
                            until you grant a permission above.
                        </p>
                    }
                }
            }
        </section>
    }
}

@code {
    private List<Family>? _families;
    private List<FamilyConnectionView> _connections = new();
    private string? _selectedFamilyId;
    private string? _userId;
    private bool _canManage;
    private string? _error;

    /// <summary>
    /// Families the user can administer (Owner). This is the "Share from"
    /// list — you can only share a family you own. Membership alone is not
    /// enough to share a family's data out.
    /// </summary>
    private List<Family> _ownedFamilies = new();

    // Co-member discovery (private: only people who share a family with me).
    private List<CoMemberRow> _coMembers = new();
    private List<ConnectableFamilyRow> _coMemberFamilies = new();
    private string? _selectedCoMemberId;
    private string? _connectSourceFamilyId;
    private string? _connectTargetFamilyId;

    private string _selectedFamilyName
        => _families?.FirstOrDefault(f => f.Id == _selectedFamilyId)?.Name ?? "this family";

    /// <summary>
    /// Targets eligible for a NEW connection from the selected source family.
    ///
    /// Excludes ONLY:
    ///   * the selected source family itself (S ≠ T)
    ///   * targets T where an active connection S → T already exists for the
    ///     currently selected source S
    ///
    /// Does NOT exclude T merely because some *other* source S2 → T exists.
    /// That is what allows sharing Chrinn's family with Jean's family after
    /// already sharing your own family with Jean's.
    /// </summary>
    private List<ConnectableFamilyRow> _availableTargets
    {
        get
        {
            if (_selectedFamilyId is null) return new();

            // _connections is already scoped to the selected source S
            // (GetOutgoingViewsAsync(_selectedFamilyId)), so its TargetFamilyId
            // values are exactly the T where S → T already exists.
            var alreadyConnectedTargets = _connections
                .Select(c => c.TargetFamilyId)
                .ToHashSet(StringComparer.Ordinal);

            return _coMemberFamilies
                .Where(f => f.FamilyId != _selectedFamilyId)
                .Where(f => !alreadyConnectedTargets.Contains(f.FamilyId))
                .ToList();
        }
    }

    private bool CanCreateCoMemberConnection
        => !string.IsNullOrEmpty(_connectSourceFamilyId)
           && !string.IsNullOrEmpty(_connectTargetFamilyId)
           && _connectSourceFamilyId != _connectTargetFamilyId;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        _userId = state.User.GetUserId();
        if (_userId is null) return;

        _families = (await Families.GetForUserAsync(_userId)).ToList();
        _coMembers = (await Discovery.GetCoMembersAsync(_userId)).ToList();

        // "Share from" lists only families the user can administer (Owner).
        // Membership alone is not enough to share a family's data out.
        _ownedFamilies = new List<Family>();
        foreach (var f in _families)
        {
            if (await Authz.CanManageSharingAsync(_userId, f.Id))
            {
                _ownedFamilies.Add(f);
            }
        }

        if (_ownedFamilies.Count > 0)
        {
            _selectedFamilyId = _ownedFamilies[0].Id;
            await LoadAsync();
        }
    }

    private async Task OnCoMemberChanged(ChangeEventArgs e)
    {
        _selectedCoMemberId = e.Value?.ToString();
        _connectSourceFamilyId = null;
        _connectTargetFamilyId = null;
        _coMemberFamilies = new();

        if (_userId is null || string.IsNullOrEmpty(_selectedCoMemberId)) return;

        _coMemberFamilies = (await Discovery.GetConnectableFamiliesForCoMemberAsync(
            _userId, _selectedCoMemberId)).ToList();
    }

    private void OnConnectSourceChanged(ChangeEventArgs e)
        => _connectSourceFamilyId = e.Value?.ToString();

    private void OnConnectTargetChanged(ChangeEventArgs e)
        => _connectTargetFamilyId = e.Value?.ToString();

    private async Task CreateCoMemberConnection()
    {
        if (!_canManage || _userId is null) return;
        if (!CanCreateCoMemberConnection) return;

        // Defensive guard: never connect a family to itself.
        if (_connectSourceFamilyId == _connectTargetFamilyId)
        {
            _error = "A family cannot be connected to itself.";
            return;
        }

        // Defensive guard: the source must be a family the user can
        // administer. The dropdown only lists owned families, but a stale
        // selection could survive a reload.
        if (!await Authz.CanManageSharingAsync(_userId, _connectSourceFamilyId!))
        {
            _error = "You can only share a family you own.";
            return;
        }

        _error = null;

        await Connections.CreateAsync(
            _connectSourceFamilyId!,
            _connectTargetFamilyId!,
            label: null,
            createdByUserId: _userId);

        // Reset the co-member picker so the new connection shows up in the
        // "Connected families" table above (where permissions are granted).
        _connectSourceFamilyId = null;
        _connectTargetFamilyId = null;
        _coMemberFamilies = new();

        await LoadAsync();
    }

    private async Task OnFamilyChanged(ChangeEventArgs e)
    {
        _selectedFamilyId = e.Value?.ToString();
        // Reset the pending target selection so it can't point at the new source.
        _connectTargetFamilyId = null;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (_userId is null || _selectedFamilyId is null) return;

        _canManage = await Authz.CanManageSharingAsync(_userId, _selectedFamilyId);
        _connections = (await Connections.GetOutgoingViewsAsync(_selectedFamilyId)).ToList();

        // If the previously selected target is no longer eligible (e.g. it
        // just became connected), clear it so the picker can't submit a
        // duplicate connection.
        if (!string.IsNullOrEmpty(_connectTargetFamilyId)
            && !_availableTargets.Any(f => f.FamilyId == _connectTargetFamilyId))
        {
            _connectTargetFamilyId = null;
        }
    }

    private async Task Toggle(FamilyConnectionView c, string kind, bool granted)
    {
        if (!_canManage || _userId is null) return;
        await Permissions.SetAsync(c.Id, kind, granted, _userId);
        await LoadAsync();
    }

    private async Task RemoveConnection(FamilyConnectionView c)
    {
        if (!_canManage) return;
        await Connections.DeleteAsync(c.Id);
        await LoadAsync();
    }
}
