@page "/compare"
@attribute [Authorize]
@rendermode InteractiveServer

@inject FamilyRepository Families
@inject PersonRepository People
@inject ChartDataService Charts
@inject AuthenticationStateProvider AuthState

<PageTitle>Compare — GrowthLog</PageTitle>

<h1>Compare growth</h1>

@if (_loading)
{
    <p>Loading…</p>
}
else
{
    <div class="compare-mode-toggle mb-3">
        <button type="button"
                class="filter-chip @(_mode == CompareModes.SameAge ? "active" : "")"
                @onclick='() => SetMode(CompareModes.SameAge)'>
            Same age
        </button>
        <button type="button"
                class="filter-chip @(_mode == CompareModes.Trajectories ? "active" : "")"
                @onclick='() => SetMode(CompareModes.Trajectories)'>
            Growth trajectories
        </button>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-md-3">
            <label class="form-label">Metric</label>
            <select class="form-select" value="@_metric" @onchange="OnMetricChanged">
                @foreach (var m in ChartMetrics.All)
                {
                    <option value="@m">@m</option>
                }
            </select>
        </div>
        @if (_mode == CompareModes.Trajectories)
        {
            <div class="col-md-3">
                <label class="form-label">X axis</label>
                <select class="form-select" value="@_xAxis" @onchange="OnXAxisChanged">
                    @foreach (var x in ChartXAxisModes.All)
                    {
                        <option value="@x">@x</option>
                    }
                </select>
            </div>
        }
    </div>

    <h2>Families</h2>
    <div class="mb-3">
        @foreach (var f in _families)
        {
            <label class="form-check form-check-inline">
                <input type="checkbox" class="form-check-input"
                       checked="@_selectedFamilyIds.Contains(f.Id)"
                       @onchange="e => ToggleFamily(f.Id, (bool)e.Value!)" />
                <span class="form-check-label">@f.Name</span>
            </label>
        }
    </div>

    <h2>People</h2>
    <div class="mb-3">
        @foreach (var p in _people)
        {
            <label class="form-check form-check-inline">
                <input type="checkbox" class="form-check-input"
                       checked="@_selectedPersonIds.Contains(p.Id)"
                       @onchange="e => TogglePerson(p.Id, (bool)e.Value!)" />
                <span class="form-check-label">@p.FullName</span>
            </label>
        }
    </div>

    @if (_mode == CompareModes.SameAge)
    {
        <h2>@_metric at age @_selectedAge.ToString("0.#")</h2>

        <div class="same-age-controls mb-3">
            <label class="form-label" for="age-slider">Age (years)</label>
            <div class="same-age-controls-row">
                <input id="age-slider" type="range"
                       min="@MinAge" max="@MaxAge" step="0.5"
                       value="@_selectedAge"
                       @oninput="OnAgeSliderChanged" />
                <input type="number" class="form-control same-age-number"
                       min="@MinAge" max="@MaxAge" step="0.5"
                       value="@_selectedAge"
                       @oninput="OnAgeNumberChanged" />
            </div>
            <p class="text-muted">Showing the nearest actual measurement within ±6 months of the selected age. Missing values are not interpolated.</p>
        </div>

        @if (_sameAgeRows.Count == 0)
        {
            <p>There isn't enough measurement data for this comparison yet.</p>
        }
        else
        {
            <div class="same-age-plot">
                @foreach (var row in _sameAgeRows)
                {
                    <div class="same-age-row">
                        <div class="same-age-name">@row.PersonName</div>
                        <div class="same-age-bar-track">
                            @if (row.Value is null)
                            {
                                <span class="same-age-missing">No measurement near age @_selectedAge.ToString("0.#")</span>
                            }
                            else
                            {
                                <div class="same-age-bar"
                                     style="width:@(BarWidthPercent(row.Value.Value))%;background:@ColorFor(row.PersonId)">
                                </div>
                            }
                        </div>
                        <div class="same-age-value">
                            @(row.Value is null ? "—" : FormatValue(row.Value.Value))
                        </div>
                    </div>
                }
            </div>
        }
    }
    else
    {
        <h2>@_metric over @(_xAxis == ChartXAxisModes.Age ? "age" : "date")</h2>
        <LineChart Series="_series"
                   XAxisMode="_xAxis"
                   YUnit="@(_metric == ChartMetrics.Weight ? "kg" : "cm")"
                   HighlightedPersonId="_highlightedPersonId"
                   OnLegendClick="OnLegendClick" />
    }

    <h2 class="mt-4">Comparison details</h2>
    @if (_series.Count == 0)
    {
        <p>No data to compare.</p>
    }
    else if (_mode == CompareModes.SameAge)
    {
        <table class="table">
            <thead>
                <tr>
                    <th>Person</th>
                    <th>@_metric</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in _sameAgeRows)
                {
                    <tr>
                        <td>@row.PersonName</td>
                        <td>@(row.Value is null ? "—" : FormatValue(row.Value.Value))</td>
                    </tr>
                }
            </tbody>
        </table>
        <p class="text-muted">Values show the nearest actual measurement within ±6 months of age @_selectedAge.ToString("0.#"). Missing values are not interpolated.</p>
    }
    else
    {
        <table class="table">
            <thead>
                <tr>
                    <th>Age (years)</th>
                    @foreach (var s in _series)
                    {
                        <th>@s.PersonName</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var age in _tableAges)
                {
                    <tr>
                        <td>@age</td>
                        @foreach (var s in _series)
                        {
                            var pt = s.Points.FirstOrDefault(p => Math.Abs(p.AgeYears - age) < 0.5);
                            <td>@(pt is null ? "—" : FormatValue(pt.Y))</td>
                        }
                    </tr>
                }
            </tbody>
        </table>
        <p class="text-muted">Values shown are the nearest actual measurement within ±6 months of each age. Missing values are not interpolated.</p>
    }
}

@code {
    private static class CompareModes
    {
        public const string SameAge = "SameAge";
        public const string Trajectories = "Trajectories";
    }

    private const double AgeToleranceYears = 0.5; // ±6 months

    private bool _loading = true;
    private string _mode = CompareModes.SameAge;
    private string _metric = ChartMetrics.Height;
    private string _xAxis = ChartXAxisModes.Age;
    private string? _userId;
    private double _selectedAge = 10;
    private string? _highlightedPersonId;

    private List<Family> _families = new();
    private List<Person> _people = new();

    // PersonId -> set of family IDs that person belongs to (from the
    // authorization-aware visible-people query). Used to drive the
    // family/person checkbox linkage.
    private readonly Dictionary<string, HashSet<string>> _personFamilies = new(StringComparer.Ordinal);

    private readonly HashSet<string> _selectedFamilyIds = new(StringComparer.Ordinal);
    private readonly HashSet<string> _selectedPersonIds = new(StringComparer.Ordinal);

    private IReadOnlyList<GrowthLog.Web.Data.Charts.ChartSeries> _series = new List<GrowthLog.Web.Data.Charts.ChartSeries>();
    private List<int> _tableAges = new();

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        _userId = state.User.GetUserId();
        if (_userId is null) return;

        _families = (await Families.GetForUserAsync(_userId)).ToList();
        foreach (var f in _families) _selectedFamilyIds.Add(f.Id);

        var rows = (await People.GetVisiblePeopleWithFamilyAsync(_userId)).ToList();

        // Build a distinct people list keyed by PersonId. A person who belongs
        // to multiple families appears exactly once, and we record every family
        // they belong to so the family/person checkboxes can stay in sync.
        _personFamilies.Clear();
        _people = rows
            .GroupBy(r => r.Id, StringComparer.Ordinal)
            .Select(g =>
            {
                var families = g.Select(r => r.FamilyId)
                    .Where(id => !string.IsNullOrEmpty(id))
                    .ToHashSet(StringComparer.Ordinal);
                _personFamilies[g.Key] = families;

                var first = g.First();
                return new Person
                {
                    Id = g.Key,
                    FirstName = first.FirstName,
                    MiddleName = first.MiddleName,
                    LastName = first.LastName,
                    DateOfBirth = first.DateOfBirth
                };
            })
            .OrderBy(p => p.FirstName)
            .ThenBy(p => p.LastName)
            .ToList();

        foreach (var p in _people) _selectedPersonIds.Add(p.Id);

        await LoadAsync();
        _loading = false;
    }

    private void SetMode(string mode)
    {
        _mode = mode;
        _highlightedPersonId = null;
    }

    private async Task OnMetricChanged(ChangeEventArgs e)
    {
        _metric = e.Value?.ToString() ?? ChartMetrics.Height;
        await LoadAsync();
    }

    private void OnAgeSliderChanged(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), out var v))
        {
            _selectedAge = Math.Clamp(v, MinAge, MaxAge);
        }
    }

    private void OnAgeNumberChanged(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), out var v))
        {
            _selectedAge = Math.Clamp(v, MinAge, MaxAge);
        }
    }

    private void OnLegendClick(string personId)
    {
        _highlightedPersonId = _highlightedPersonId == personId ? null : personId;
    }

    private async Task OnXAxisChanged(ChangeEventArgs e)
    {
        _xAxis = e.Value?.ToString() ?? ChartXAxisModes.Age;
        await LoadAsync();
    }

    private async Task ToggleFamily(string familyId, bool selected)
    {
        if (selected)
        {
            _selectedFamilyIds.Add(familyId);

            // Auto-check every person who belongs to this family.
            foreach (var (personId, families) in _personFamilies)
            {
                if (families.Contains(familyId))
                {
                    _selectedPersonIds.Add(personId);
                }
            }
        }
        else
        {
            _selectedFamilyIds.Remove(familyId);

            // Uncheck people who belonged to this family, unless they still
            // belong to at least one other family that remains checked.
            foreach (var (personId, families) in _personFamilies)
            {
                if (!families.Contains(familyId)) continue;

                var stillVisible = families.Any(f => _selectedFamilyIds.Contains(f));
                if (!stillVisible)
                {
                    _selectedPersonIds.Remove(personId);
                }
            }
        }

        await LoadAsync();
    }

    private async Task TogglePerson(string personId, bool selected)
    {
        if (selected) _selectedPersonIds.Add(personId);
        else _selectedPersonIds.Remove(personId);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (_userId is null) return;

        // Only request people who are both selected AND still belong to at
        // least one selected family. This keeps the chart consistent with the
        // checkbox state even if a person was left checked by an edge case.
        var effectivePersonIds = _selectedPersonIds
            .Where(id => _personFamilies.TryGetValue(id, out var fams)
                         && fams.Any(f => _selectedFamilyIds.Contains(f)))
            .ToHashSet(StringComparer.Ordinal);

        _series = await Charts.GetSeriesAsync(
            _userId,
            _metric,
            effectivePersonIds,
            _selectedFamilyIds);

        // Build a simple integer-age table from actual points.
        var ages = _series.SelectMany(s => s.Points)
            .Select(p => (int)Math.Floor(p.AgeYears))
            .Distinct()
            .OrderBy(a => a)
            .ToList();
        _tableAges = ages;
    }

    private string FormatValue(double v)
        => _metric == ChartMetrics.Weight ? $"{v:0.#} kg" : $"{v:0.#} cm";

    private double MinAge => 0;

    private double MaxAge
    {
        get
        {
            var max = _series.SelectMany(s => s.Points).Select(p => p.AgeYears).DefaultIfEmpty(18).Max();
            return Math.Max(1, Math.Ceiling(max));
        }
    }

    private sealed class SameAgeRow
    {
        public string PersonId { get; set; } = string.Empty;
        public string PersonName { get; set; } = string.Empty;
        public double? Value { get; set; }
    }

    private List<SameAgeRow> _sameAgeRows
    {
        get
        {
            var rows = new List<SameAgeRow>();
            foreach (var s in _series)
            {
                var nearest = s.Points
                    .Where(p => Math.Abs(p.AgeYears - _selectedAge) <= AgeToleranceYears)
                    .OrderBy(p => Math.Abs(p.AgeYears - _selectedAge))
                    .FirstOrDefault();

                rows.Add(new SameAgeRow
                {
                    PersonId = s.PersonId,
                    PersonName = s.PersonName,
                    Value = nearest?.Y
                });
            }
            return rows.OrderByDescending(r => r.Value ?? double.MinValue).ToList();
        }
    }

    private double _sameAgeMaxValue
        => _sameAgeRows.Where(r => r.Value is not null).Select(r => r.Value!.Value).DefaultIfEmpty(1).Max();

    private double BarWidthPercent(double value)
    {
        var max = _sameAgeMaxValue;
        if (max <= 0) return 0;
        return Math.Max(2, value / max * 100);
    }

    private static readonly string[] Palette =
    {
        "#2563eb", "#dc2626", "#16a34a", "#d97706", "#7c3aed",
        "#0891b2", "#db2777", "#65a30d", "#ea580c", "#4f46e5"
    };

    private static string ColorFor(string personId)
    {
        var hash = 0;
        foreach (var c in personId) hash = (hash * 31 + c) & 0x7fffffff;
        return Palette[hash % Palette.Length];
    }
}
