@page "/compare"
@attribute [Authorize]
@rendermode InteractiveServer

@inject FamilyRepository Families
@inject PersonRepository People
@inject ChartDataService Charts
@inject AuthenticationStateProvider AuthState
@inject UserManager<ApplicationUser> UserManager

<PageTitle>Compare — GrowthLog</PageTitle>

<h1>Compare growth</h1>

@if (_loading)
{
    <p>Loading…</p>
}
else
{
    <div class="chart-family-chips">
        @foreach (var f in _families)
        {
            <button type="button"
                    class="filter-chip @(_selectedFamilyIds.Contains(f.Id) ? "active" : "")"
                    @onclick="() => ToggleFamilyChip(f.Id)">
                @f.Name
            </button>
        }
    </div>

    <div class="chart-toolbar">
        <div class="chart-metric-toggle">
            <button type="button"
                    class="filter-chip @(_metric == ChartMetrics.Height ? "active" : "")"
                    @onclick='() => SetMetric(ChartMetrics.Height)'>
                Height
            </button>
            <button type="button"
                    class="filter-chip @(_metric == ChartMetrics.Weight ? "active" : "")"
                    @onclick='() => SetMetric(ChartMetrics.Weight)'>
                Weight
            </button>
            <button type="button"
                    class="filter-chip @(_metric == MetricModes.Both ? "active" : "")"
                    @onclick='() => SetMetric(MetricModes.Both)'>
                Both
            </button>
        </div>
    </div>

    <div class="compare-chart-area">
        <h2 class="compare-chart-title">@MetricTitle at age @_selectedAge.ToString("0.#")</h2>

        <div class="same-age-controls mb-3">
            <label class="form-label" for="age-slider">Age (years)</label>
            <div class="same-age-controls-row">
                <input id="age-slider" type="range"
                       min="@MinAge" max="@MaxAge" step="1"
                       value="@_selectedAge"
                       @oninput="OnAgeSliderChanged" />
                <input type="number" class="form-control same-age-number"
                       min="@MinAge" max="@MaxAge" step="1"
                       value="@_selectedAge"
                       @oninput="OnAgeNumberChanged" />
            </div>
            <p class="text-muted">Nearest actual measurement within ±6 months of the selected age. Missing values are not interpolated.</p>
        </div>

        @if (_barRows.Count == 0)
        {
            <EmptyState Icon="📊"
                        Title="There isn't enough measurement data for this comparison yet."
                        Description="Select families or people with recorded measurements, or add a measurement first." />
        }
        else
        {
            @if (_metric == MetricModes.Both)
            {
                <div class="both-chart">
                    <div class="both-chart-axis-row">
                        <span class="both-chart-axis-label both-chart-axis-left">Height (@(_unitSystem == "Metric" ? "cm" : "ft-in"))</span>
                        <span class="both-chart-axis-label both-chart-axis-right">Weight (@(_unitSystem == "Metric" ? "kg" : "lb"))</span>
                    </div>
                    <div class="chart-scroll">
                    <div class="both-chart-plot">
                        @foreach (var row in _barRows)
                        {
                            <div class="both-chart-col" title="@TooltipFor(row)">
                                <div class="both-chart-value">@FormatValue(row.HeightValue ?? 0)</div>
                                <div class="both-chart-track">
                                    <div class="both-chart-bar"
                                         style="height:@(BarHeightPercent(row.HeightValue ?? 0, _barMaxHeight).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%;background:@ColorFor(row.PersonId)">
                                    </div>
                                </div>
                                <button type="button"
                                        class="both-chart-name chart-name-toggle"
                                        title="@($"{row.PersonName} — click to hide")"
                                        @onclick="() => TogglePerson(row.PersonId)">
                                    @row.FirstName
                                </button>
                            </div>
                        }
                    </div>
                    <svg class="both-chart-line"
                         viewBox="0 0 @BothPlotWidth @BothPlotHeight"
                         preserveAspectRatio="none">
                        @if (_weightLinePoints.Length > 1)
                        {
                            <polyline fill="none" stroke="#dc2626" stroke-width="2"
                                      stroke-linejoin="round" stroke-linecap="round"
                                      points="@_weightLinePoints" />
                        }
                    </svg>
                    @foreach (var pt in _weightLineDots)
                    {
                        <span class="both-chart-dot"
                              style="left:@(pt.LeftPercent.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%;top:@(pt.TopPercent.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%"></span>
                    }
                    @foreach (var lbl in _weightLabels)
                    {
                        <span class="both-chart-weight-label"
                              style="left:@(lbl.LeftPercent.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%;top:@(lbl.TopPercent.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%">
                            @lbl.Text
                        </span>
                    }
                    </div>
                </div>
            }
            else
            {
                <div class="vbar-chart">
                    <div class="chart-scroll">
                    <div class="vbar-plot">
                        @foreach (var row in _barRows)
                        {
                            <div class="vbar-col" title="@TooltipFor(row)">
                                <div class="vbar-value">@FormatValue(row.Value!.Value)</div>
                                <div class="vbar-track">
                                    <div class="vbar-bar"
                                         style="height:@(BarHeightPercent(row.Value!.Value, _barMaxValue).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%;background:@ColorFor(row.PersonId)">
                                    </div>
                                </div>
                                <button type="button"
                                        class="vbar-name chart-name-toggle"
                                        title="@($"{row.PersonName} — click to hide")"
                                        @onclick="() => TogglePerson(row.PersonId)">
                                    @row.FirstName
                                </button>
                            </div>
                        }
                    </div>
                    </div>
                </div>
            }

            @if (_missingBarRows.Count > 0)
            {
                <div class="same-age-missing-section">
                    <h3 class="same-age-missing-heading">No measurement near age @_selectedAge.ToString("0.#")</h3>
                    <ul class="same-age-missing-list">
                        @foreach (var row in _missingBarRows)
                        {
                            <li>@row.PersonName</li>
                        }
                    </ul>
                </div>
            }
        }

        @if (_legendPeople.Count > 0)
        {
            <div class="chart-legend">
                @foreach (var p in _legendPeople)
                {
                    var hidden = _hiddenPersonIds.Contains(p.Id);
                    <button type="button"
                            class="legend-item @(hidden ? "legend-item-muted" : "")"
                            title="@(hidden ? $"Show {p.FullName}" : $"Hide {p.FullName}")"
                            @onclick="() => TogglePerson(p.Id)">
                        <span class="legend-swatch" style="background:@ColorFor(p.Id)"></span>
                        @p.FirstName
                    </button>
                }
            </div>
        }
    </div>

    <div class="section-header mt-4">
        <h2>Comparison details</h2>
        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => _showDetails = !_showDetails">
            @(_showDetails ? "Hide details" : "Show details")
        </button>
    </div>
    @if (_showDetails)
    {
        if (_barRows.Count == 0 && _missingBarRows.Count == 0)
        {
            <EmptyState Icon="📊"
                        Title="No data to compare."
                        Description="Select at least one person with recorded measurements." />
        }
        else
        {
            <table class="table">
                <thead>
                    <tr>
                        <th>Person</th>
                        <th>@MetricTitle</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in _barRows.Concat(_missingBarRows))
                    {
                        <tr>
                            <td>@row.PersonName</td>
                            <td>@(row.Value is null ? "—" : FormatValue(row.Value.Value))</td>
                        </tr>
                    }
                </tbody>
            </table>
            <p class="text-muted">Values show the nearest actual measurement within ±6 months of age @_selectedAge.ToString("0.#"). Missing values are not interpolated.</p>
        }
    }
}

@code {
    private static class MetricModes
    {
        public const string Both = "Both";
    }

    private const double AgeToleranceYears = 0.5; // ±6 months

    private bool _loading = true;
    private string _metric = ChartMetrics.Height;
    private string? _userId;
    private string _unitSystem = "Imperial";
    private double _selectedAge = 10;
    private bool _showDetails;

    private List<Family> _families = new();

    // PersonId -> set of family IDs that person belongs to (from the
    // authorization-aware visible-people query).
    private readonly Dictionary<string, HashSet<string>> _personFamilies = new(StringComparer.Ordinal);

    // PersonId -> Person, for building the chart rows.
    private readonly Dictionary<string, Person> _peopleById = new(StringComparer.Ordinal);

    private readonly HashSet<string> _selectedFamilyIds = new(StringComparer.Ordinal);
    private readonly HashSet<string> _hiddenPersonIds = new(StringComparer.Ordinal);

    private IReadOnlyList<GrowthLog.Web.Data.Charts.ChartSeries> _series = new List<GrowthLog.Web.Data.Charts.ChartSeries>();

    private List<BarRow> _barRows = new();
    private List<BarRow> _missingBarRows = new();
    private double _barMaxValue = 1;
    private double _barMaxHeight = 1;
    private double _barMaxWeight = 1;
    private string _weightLinePoints = string.Empty;
    private List<WeightDot> _weightLineDots = new();
    private List<WeightLabel> _weightLabels = new();

    private const double BothPlotWidth = 1000;
    private const double BothPlotHeight = 260;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        _userId = state.User.GetUserId();
        if (_userId is null) return;

        var user = await UserManager.FindByIdAsync(_userId);
        _unitSystem = UnitConverter.NormalizeUnitSystem(user?.PreferredUnitSystem);

        _families = (await Families.GetForUserAsync(_userId)).ToList();
        foreach (var f in _families) _selectedFamilyIds.Add(f.Id);

        var rows = (await People.GetVisiblePeopleWithFamilyAsync(_userId)).ToList();

        _personFamilies.Clear();
        _peopleById.Clear();
        foreach (var g in rows.GroupBy(r => r.Id, StringComparer.Ordinal))
        {
            var families = g.Select(r => r.FamilyId)
                .Where(id => !string.IsNullOrEmpty(id))
                .ToHashSet(StringComparer.Ordinal);
            _personFamilies[g.Key] = families;

            var first = g.First();
            _peopleById[g.Key] = new Person
            {
                Id = g.Key,
                FirstName = first.FirstName,
                MiddleName = first.MiddleName,
                LastName = first.LastName,
                DateOfBirth = first.DateOfBirth
            };
        }

        await LoadAsync();
        _loading = false;
    }

    private async Task SetMetric(string metric)
    {
        _metric = metric;
        await LoadAsync();
    }

    private async Task OnAgeSliderChanged(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), out var v))
        {
            _selectedAge = Math.Clamp(v, MinAge, MaxAge);
            await LoadAsync();
        }
    }

    private async Task OnAgeNumberChanged(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), out var v))
        {
            _selectedAge = Math.Clamp(v, MinAge, MaxAge);
            await LoadAsync();
        }
    }

    private async Task ToggleFamilyChip(string familyId)
    {
        if (!_selectedFamilyIds.Remove(familyId))
        {
            _selectedFamilyIds.Add(familyId);
        }
        await LoadAsync();
    }

    private async Task TogglePerson(string personId)
    {
        if (!_hiddenPersonIds.Remove(personId))
        {
            _hiddenPersonIds.Add(personId);
        }
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (_userId is null) return;

        // People who belong to at least one selected family and are not hidden.
        var visiblePersonIds = _personFamilies
            .Where(kv => kv.Value.Any(f => _selectedFamilyIds.Contains(f)))
            .Select(kv => kv.Key)
            .Where(id => !_hiddenPersonIds.Contains(id))
            .ToHashSet(StringComparer.Ordinal);

        // The line chart shows a single metric; "Both" falls back to Height.
        var lineMetric = _metric == MetricModes.Both ? ChartMetrics.Height : _metric;

        _series = visiblePersonIds.Count == 0
            ? new List<GrowthLog.Web.Data.Charts.ChartSeries>()
            : await Charts.GetSeriesAsync(_userId, lineMetric, visiblePersonIds, _selectedFamilyIds);

        IReadOnlyList<GrowthLog.Web.Data.Charts.ChartSeries> heightSeries = _series;
        IReadOnlyList<GrowthLog.Web.Data.Charts.ChartSeries> weightSeries = _series;

        if (_metric == MetricModes.Both && visiblePersonIds.Count > 0)
        {
            heightSeries = await Charts.GetSeriesAsync(_userId, ChartMetrics.Height, visiblePersonIds, _selectedFamilyIds);
            weightSeries = await Charts.GetSeriesAsync(_userId, ChartMetrics.Weight, visiblePersonIds, _selectedFamilyIds);
        }

        var heightById = heightSeries.ToDictionary(s => s.PersonId, StringComparer.Ordinal);
        var weightById = weightSeries.ToDictionary(s => s.PersonId, StringComparer.Ordinal);

        // Oldest -> youngest among the currently visible people.
        var orderedPeople = visiblePersonIds
            .Select(id => _peopleById.GetValueOrDefault(id))
            .Where(p => p is not null)
            .Select(p => p!)
            .OrderBy(p => ParseDob(p.DateOfBirth))
            .ToList();

        var rows = new List<BarRow>();
        foreach (var p in orderedPeople)
        {
            double? height = NearestValue(heightById, p.Id, _selectedAge);
            double? weight = NearestValue(weightById, p.Id, _selectedAge);

            rows.Add(new BarRow
            {
                PersonId = p.Id,
                PersonName = p.FullName,
                FirstName = p.FirstName,
                Value = _metric == ChartMetrics.Weight ? weight : height,
                HeightValue = height,
                WeightValue = weight
            });
        }

        if (_metric == MetricModes.Both)
        {
            _barRows = rows.Where(r => r.HeightValue is not null || r.WeightValue is not null).ToList();
            _missingBarRows = rows.Where(r => r.HeightValue is null && r.WeightValue is null).ToList();
            _barMaxHeight = _barRows.Select(r => r.HeightValue ?? 0).DefaultIfEmpty(1).Max();
            _barMaxWeight = _barRows.Select(r => r.WeightValue ?? 0).DefaultIfEmpty(1).Max();
            BuildWeightLine();
        }
        else
        {
            _barRows = rows.Where(r => r.Value is not null).ToList();
            _missingBarRows = rows.Where(r => r.Value is null).ToList();
            _barMaxValue = _barRows.Select(r => r.Value!.Value).DefaultIfEmpty(1).Max();
            _weightLinePoints = string.Empty;
            _weightLineDots = new();
            _weightLabels = new();
        }
    }

    private void BuildWeightLine()
    {
        _weightLineDots = new();
        _weightLabels = new();

        var count = _barRows.Count;
        if (count == 0 || _barMaxWeight <= 0)
        {
            _weightLinePoints = string.Empty;
            return;
        }

        var pts = new List<string>();
        for (var i = 0; i < count; i++)
        {
            var row = _barRows[i];
            if (row.WeightValue is null) continue;

            var x = (i + 0.5) * (BothPlotWidth / count);
            var y = BothPlotHeight - (row.WeightValue.Value / _barMaxWeight * BothPlotHeight);
            y = Math.Clamp(y, 0, BothPlotHeight);

            pts.Add($"{x.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)},{y.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)}");

            _weightLineDots.Add(new WeightDot
            {
                LeftPercent = x / BothPlotWidth * 100.0,
                TopPercent = y / BothPlotHeight * 100.0
            });

            _weightLabels.Add(new WeightLabel
            {
                Text = UnitConverter.FormatWeight(row.WeightValue, _unitSystem),
                LeftPercent = x / BothPlotWidth * 100.0,
                TopPercent = Math.Max(0, (y - 18) / BothPlotHeight * 100.0)
            });
        }

        _weightLinePoints = string.Join(" ", pts);
    }

    private static double? NearestValue(
        IReadOnlyDictionary<string, GrowthLog.Web.Data.Charts.ChartSeries> byId,
        string personId,
        double age)
    {
        if (!byId.TryGetValue(personId, out var s)) return null;
        return s.Points
            .Where(pt => Math.Abs(pt.AgeYears - age) <= AgeToleranceYears)
            .OrderBy(pt => Math.Abs(pt.AgeYears - age))
            .FirstOrDefault()?.Y;
    }

    private static DateOnly ParseDob(string dob)
        => DateOnly.TryParse(dob, out var d) ? d : DateOnly.MaxValue;

    private string MetricTitle
        => _metric == MetricModes.Both ? "Height & weight" : _metric;

    /// <summary>
    /// People in the currently selected families, ordered oldest -> youngest.
    /// Includes hidden people so the legend can show them as muted and let the
    /// user turn them back on.
    /// </summary>
    private List<Person> _legendPeople
        => _personFamilies
            .Where(kv => kv.Value.Any(f => _selectedFamilyIds.Contains(f)))
            .Select(kv => _peopleById.GetValueOrDefault(kv.Key))
            .Where(p => p is not null)
            .Select(p => p!)
            .OrderBy(p => ParseDob(p.DateOfBirth))
            .ToList();

    private string FormatValue(double v)
        => _metric == ChartMetrics.Weight
            ? UnitConverter.FormatWeight(v, _unitSystem)
            : UnitConverter.FormatHeight(v, _unitSystem);

    private string TooltipFor(BarRow row)
    {
        var age = _selectedAge.ToString("0.#");
        var lines = new List<string> { row.PersonName, $"Age {age}" };

        if (_metric == MetricModes.Both)
        {
            if (row.HeightValue is not null)
                lines.Add($"Height: {UnitConverter.FormatHeight(row.HeightValue, _unitSystem)}");
            if (row.WeightValue is not null)
                lines.Add($"Weight: {UnitConverter.FormatWeight(row.WeightValue, _unitSystem)}");
        }
        else if (row.Value is not null)
        {
            lines.Add(_metric == ChartMetrics.Weight
                ? $"Weight: {UnitConverter.FormatWeight(row.Value, _unitSystem)}"
                : $"Height: {UnitConverter.FormatHeight(row.Value, _unitSystem)}");
        }

        return string.Join("\n", lines);
    }

    private static double BarHeightPercent(double value, double max)
    {
        if (max <= 0) return 0;
        return Math.Max(2, value / max * 100);
    }

    private double MinAge => 0;

    private double MaxAge
    {
        get
        {
            var max = _series.SelectMany(s => s.Points).Select(p => p.AgeYears).DefaultIfEmpty(18).Max();
            return Math.Max(1, Math.Ceiling(max));
        }
    }

    private static readonly string[] Palette =
    {
        "#1d4ed8", "#dc2626", "#15803d", "#b45309", "#7e22ce",
        "#0e7490", "#be185d", "#4d7c0f", "#c2410c", "#4338ca"
    };

    private static string ColorFor(string personId)
    {
        var hash = 0;
        foreach (var c in personId) hash = (hash * 31 + c) & 0x7fffffff;
        return Palette[hash % Palette.Length];
    }

    private class BarRow
    {
        public string PersonId { get; set; } = string.Empty;
        public string PersonName { get; set; } = string.Empty;
        public string FirstName { get; set; } = string.Empty;
        public double? Value { get; set; }
        public double? HeightValue { get; set; }
        public double? WeightValue { get; set; }
    }

    private class WeightDot
    {
        public double LeftPercent { get; set; }
        public double TopPercent { get; set; }
    }

    private class WeightLabel
    {
        public string Text { get; set; } = string.Empty;
        public double LeftPercent { get; set; }
        public double TopPercent { get; set; }
    }
}

<style>
    .compare-chart-area {
        margin-bottom: 1rem;
    }

    /* The chart card must render identically to the Dashboard snapshot.
       Do not add Compare-only overrides that lighten strokes, reduce
       opacity, or shrink markers. */
    .compare-chart-area .chart-card {
        padding: 1rem 1rem 0.75rem;
    }

    .compare-chart-title {
        margin-top: 0.25rem;
        margin-bottom: 0.5rem;
    }

    .same-age-plot {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        margin-bottom: 1.5rem;
    }

    .same-age-row {
        display: grid;
        grid-template-columns: 1.75rem minmax(8rem, 12rem) 1fr 5.5rem;
        align-items: center;
        gap: 0.75rem;
    }

    .same-age-rank {
        font-size: 0.8rem;
        font-weight: 600;
        color: #6b7280;
        text-align: right;
    }

    .same-age-name {
        font-weight: 500;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .same-age-bar-track {
        position: relative;
        height: 1.5rem;
        background: #f1f3f5;
        border-radius: 0.375rem;
        overflow: hidden;
    }

    .same-age-bar {
        height: 100%;
        border-radius: 0.375rem;
        transition: width 0.2s ease;
    }

    .same-age-value {
        font-variant-numeric: tabular-nums;
        font-weight: 600;
        text-align: right;
        white-space: nowrap;
    }

    .same-age-missing-section {
        margin-top: 1rem;
        padding: 0.75rem 1rem;
        background: #f8f9fa;
        border-radius: 0.5rem;
        color: #6b7280;
    }

    .same-age-missing-heading {
        font-size: 0.95rem;
        font-weight: 600;
        margin: 0 0 0.5rem 0;
        color: #6b7280;
    }

    .same-age-missing-list {
        margin: 0;
        padding-left: 1.25rem;
    }

    .same-age-missing-list li {
        margin: 0.15rem 0;
    }
</style>
