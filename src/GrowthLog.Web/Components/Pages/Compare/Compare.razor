@page "/compare"
@attribute [Authorize]
@rendermode InteractiveServer

@inject FamilyRepository Families
@inject PersonRepository People
@inject ChartDataService Charts
@inject AuthenticationStateProvider AuthState
@inject UserManager<ApplicationUser> UserManager

<PageTitle>Compare — GrowthLog</PageTitle>

<h1>Compare growth</h1>

@if (_loading)
{
    <p>Loading…</p>
}
else
{
    <div class="compare-toolbar">
        <div class="compare-mode-toggle">
            <button type="button"
                    class="filter-chip @(_mode == CompareModes.SameAge ? "active" : "")"
                    @onclick='() => SetMode(CompareModes.SameAge)'>
                Same age
            </button>
            <button type="button"
                    class="filter-chip @(_mode == CompareModes.OverTime ? "active" : "")"
                    @onclick='() => SetMode(CompareModes.OverTime)'>
                Over time
            </button>
        </div>

        <div class="compare-toolbar-controls">
            <label class="compare-inline-label" for="compare-metric">Metric</label>
            <select id="compare-metric" class="form-select form-select-sm compare-inline-select"
                    value="@_metric" @onchange="OnMetricChanged">
                @foreach (var m in ChartMetrics.All)
                {
                    <option value="@m">@m</option>
                }
            </select>

            @if (_mode == CompareModes.OverTime)
            {
                <label class="compare-inline-label" for="compare-xaxis">X axis</label>
                <select id="compare-xaxis" class="form-select form-select-sm compare-inline-select"
                        value="@_xAxis" @onchange="OnXAxisChanged">
                    @foreach (var x in ChartXAxisModes.All)
                    {
                        <option value="@x">@x</option>
                    }
                </select>
            }
        </div>
    </div>

    <div class="compare-filters">
        <button type="button" class="compare-filters-toggle"
                aria-expanded="@_filtersOpen"
                @onclick="() => _filtersOpen = !_filtersOpen">
            <span>@(_filtersOpen ? "▾" : "▸") Filters</span>
            <span class="compare-filters-summary">@FiltersSummary</span>
        </button>

        @if (_filtersOpen)
        {
            <div class="compare-filters-body">
                <div class="compare-filter-group">
                    <div class="compare-filter-heading">Families</div>
                    @foreach (var f in _families)
                    {
                        <label class="form-check form-check-inline">
                            <input type="checkbox" class="form-check-input"
                                   checked="@_selectedFamilyIds.Contains(f.Id)"
                                   @onchange="e => ToggleFamily(f.Id, (bool)e.Value!)" />
                            <span class="form-check-label">@f.Name</span>
                        </label>
                    }
                </div>

                <div class="compare-filter-group">
                    <div class="compare-filter-heading">People</div>
                    @foreach (var p in _people)
                    {
                        <label class="form-check form-check-inline">
                            <input type="checkbox" class="form-check-input"
                                   checked="@_selectedPersonIds.Contains(p.Id)"
                                   @onchange="e => TogglePerson(p.Id, (bool)e.Value!)" />
                            <span class="form-check-label">@p.FullName</span>
                        </label>
                    }
                </div>
            </div>
        }
    </div>

    <div class="compare-chart-area">
    @if (_mode == CompareModes.SameAge)
    {
        <h2 class="compare-chart-title">@_metric at age @_selectedAge.ToString("0.#")</h2>

        <div class="same-age-controls mb-3">
            <label class="form-label" for="age-slider">Age (years)</label>
            <div class="same-age-controls-row">
                <input id="age-slider" type="range"
                       min="@MinAge" max="@MaxAge" step="1"
                       value="@_selectedAge"
                       @oninput="OnAgeSliderChanged" />
                <input type="number" class="form-control same-age-number"
                       min="@MinAge" max="@MaxAge" step="1"
                       value="@_selectedAge"
                       @oninput="OnAgeNumberChanged" />
            </div>
            <p class="text-muted">Showing the nearest actual measurement within ±6 months of the selected age. Missing values are not interpolated.</p>
        </div>

        @if (_sameAgeRows.Count == 0)
        {
            <EmptyState Icon="📊"
                        Title="There isn't enough measurement data for this comparison yet."
                        Description="Select people with recorded measurements, or add a measurement first." />
        }
        else
        {
            @if (_rankedSameAgeRows.Count > 0)
            {
                <div class="same-age-plot">
                    @{ var rank = 0; }
                    @foreach (var row in _rankedSameAgeRows)
                    {
                        rank++;
                        <div class="same-age-row">
                            <div class="same-age-rank">@rank</div>
                            <div class="same-age-name">@row.PersonName</div>
                            <div class="same-age-bar-track">
                                <div class="same-age-bar"
                                     style="width:@(BarWidthPercent(row.Value!.Value).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%;background:@ColorFor(row.PersonId)">
                                </div>
                            </div>
                            <div class="same-age-value">@FormatValue(row.Value!.Value)</div>
                        </div>
                    }
                </div>
            }

            @if (_missingSameAgeRows.Count > 0)
            {
                <div class="same-age-missing-section">
                    <h3 class="same-age-missing-heading">No measurement near age @_selectedAge.ToString("0.#")</h3>
                    <ul class="same-age-missing-list">
                        @foreach (var row in _missingSameAgeRows)
                        {
                            <li>@row.PersonName</li>
                        }
                    </ul>
                </div>
            }
        }
    }
    else
    {
        <h2 class="compare-chart-title">@_metric over @(_xAxis == ChartXAxisModes.Age ? "age" : "date")</h2>
        @if (_series.Count > MaxOverTimePeople)
        {
            <p class="text-muted">
                Showing @_series.Count people. Click a name in the legend to focus one person,
                or uncheck people above to reduce clutter.
            </p>
        }
        @if (_highlightedPersonId is not null)
        {
            <p>
                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => _highlightedPersonId = null">
                    Show all people
                </button>
            </p>
        }
        @* <LineChart Series="_series"
                   XAxisMode="_xAxis"
                   YUnit="@(_metric == ChartMetrics.Weight ? "kg" : "cm")"
                   UnitSystem="_unitSystem"
                   HighlightedPersonId="_highlightedPersonId"
                   OnLegendClick="OnLegendClick"
                   Class="chart-card" /> *@

        <LineChart Series="_series"
                    XAxisMode="_xAxis"
                    Metric="_metric"
                    YUnit="@(_metric == ChartMetrics.Weight ? "kg" : "cm")"
                    UnitSystem="_unitSystem"
                    Class="chart-card" />
    }
    </div>

    <div class="section-header mt-4">
        <h2>Comparison details</h2>
        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => _showDetails = !_showDetails">
            @(_showDetails ? "Hide details" : "Show details")
        </button>
    </div>
    @if (_showDetails)
    {
        if (_series.Count == 0)
        {
            <EmptyState Icon="📊"
                        Title="No data to compare."
                        Description="Select at least one person with recorded measurements." />
        }
        else if (_mode == CompareModes.SameAge)
        {
            <table class="table">
                <thead>
                    <tr>
                        <th>Person</th>
                        <th>@_metric</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in _sameAgeRows)
                    {
                        <tr>
                            <td>@row.PersonName</td>
                            <td>@(row.Value is null ? "—" : FormatValue(row.Value.Value))</td>
                        </tr>
                    }
                </tbody>
            </table>
            <p class="text-muted">Values show the nearest actual measurement within ±6 months of age @_selectedAge.ToString("0.#"). Missing values are not interpolated.</p>
        }
        else
        {
            <table class="table">
                <thead>
                    <tr>
                        <th>Age (years)</th>
                        @foreach (var s in _series)
                        {
                            <th>@s.PersonName</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var age in _tableAges)
                    {
                        <tr>
                            <td>@age</td>
                            @foreach (var s in _series)
                            {
                                var pt = s.Points.FirstOrDefault(p => Math.Abs(p.AgeYears - age) < 0.5);
                                <td>@(pt is null ? "—" : FormatValue(pt.Y))</td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
            <p class="text-muted">Values shown are the nearest actual measurement within ±6 months of each age. Missing values are not interpolated.</p>
        }
    }
}

@code {
    private static class CompareModes
    {
        public const string SameAge = "SameAge";
        public const string OverTime = "OverTime";
    }

    private const double AgeToleranceYears = 0.5; // ±6 months
    private const int MaxOverTimePeople = 5;

    private bool _loading = true;
    private string _mode = CompareModes.SameAge;
    private string _metric = ChartMetrics.Height;
    private string _xAxis = ChartXAxisModes.Age;
    private string? _userId;
    private string _unitSystem = "Imperial";
    private double _selectedAge = 10;
    private string? _highlightedPersonId;
    private bool _showDetails;
    private bool _filtersOpen;

    private List<Family> _families = new();
    private List<Person> _people = new();

    // PersonId -> set of family IDs that person belongs to (from the
    // authorization-aware visible-people query). Used to drive the
    // family/person checkbox linkage.
    private readonly Dictionary<string, HashSet<string>> _personFamilies = new(StringComparer.Ordinal);

    private readonly HashSet<string> _selectedFamilyIds = new(StringComparer.Ordinal);
    private readonly HashSet<string> _selectedPersonIds = new(StringComparer.Ordinal);

    private IReadOnlyList<GrowthLog.Web.Data.Charts.ChartSeries> _series = new List<GrowthLog.Web.Data.Charts.ChartSeries>();
    private List<int> _tableAges = new();

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        _userId = state.User.GetUserId();
        if (_userId is null) return;

        var user = await UserManager.FindByIdAsync(_userId);
        _unitSystem = UnitConverter.NormalizeUnitSystem(user?.PreferredUnitSystem);

        _families = (await Families.GetForUserAsync(_userId)).ToList();
        foreach (var f in _families) _selectedFamilyIds.Add(f.Id);

        var rows = (await People.GetVisiblePeopleWithFamilyAsync(_userId)).ToList();

        // Build a distinct people list keyed by PersonId. A person who belongs
        // to multiple families appears exactly once, and we record every family
        // they belong to so the family/person checkboxes can stay in sync.
        _personFamilies.Clear();
        _people = rows
            .GroupBy(r => r.Id, StringComparer.Ordinal)
            .Select(g =>
            {
                var families = g.Select(r => r.FamilyId)
                    .Where(id => !string.IsNullOrEmpty(id))
                    .ToHashSet(StringComparer.Ordinal);
                _personFamilies[g.Key] = families;

                var first = g.First();
                return new Person
                {
                    Id = g.Key,
                    FirstName = first.FirstName,
                    MiddleName = first.MiddleName,
                    LastName = first.LastName,
                    DateOfBirth = first.DateOfBirth
                };
            })
            .OrderBy(p => p.FirstName)
            .ThenBy(p => p.LastName)
            .ToList();

        // Default to a readable number of people for the over-time chart.
        // Users can still check more; this just avoids an unreadable default.
        foreach (var p in _people.Take(MaxOverTimePeople)) _selectedPersonIds.Add(p.Id);

        await LoadAsync();
        _loading = false;
    }

    private void SetMode(string mode)
    {
        _mode = mode;
        _highlightedPersonId = null;
    }

    private async Task OnMetricChanged(ChangeEventArgs e)
    {
        _metric = e.Value?.ToString() ?? ChartMetrics.Height;
        await LoadAsync();
    }

    private void OnAgeSliderChanged(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), out var v))
        {
            _selectedAge = Math.Clamp(v, MinAge, MaxAge);
        }
    }

    private void OnAgeNumberChanged(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), out var v))
        {
            _selectedAge = Math.Clamp(v, MinAge, MaxAge);
        }
    }

    private void OnLegendClick(string personId)
    {
        _highlightedPersonId = _highlightedPersonId == personId ? null : personId;
    }

    private async Task OnXAxisChanged(ChangeEventArgs e)
    {
        _xAxis = e.Value?.ToString() ?? ChartXAxisModes.Age;
        await LoadAsync();
    }

    private async Task ToggleFamily(string familyId, bool selected)
    {
        if (selected)
        {
            _selectedFamilyIds.Add(familyId);

            // Auto-check every person who belongs to this family.
            foreach (var (personId, families) in _personFamilies)
            {
                if (families.Contains(familyId))
                {
                    _selectedPersonIds.Add(personId);
                }
            }
        }
        else
        {
            _selectedFamilyIds.Remove(familyId);

            // Uncheck people who belonged to this family, unless they still
            // belong to at least one other family that remains checked.
            foreach (var (personId, families) in _personFamilies)
            {
                if (!families.Contains(familyId)) continue;

                var stillVisible = families.Any(f => _selectedFamilyIds.Contains(f));
                if (!stillVisible)
                {
                    _selectedPersonIds.Remove(personId);
                }
            }
        }

        await LoadAsync();
    }

    private async Task TogglePerson(string personId, bool selected)
    {
        if (selected) _selectedPersonIds.Add(personId);
        else _selectedPersonIds.Remove(personId);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (_userId is null) return;

        // Only request people who are both selected AND still belong to at
        // least one selected family. This keeps the chart consistent with the
        // checkbox state even if a person was left checked by an edge case.
        var effectivePersonIds = _selectedPersonIds
            .Where(id => _personFamilies.TryGetValue(id, out var fams)
                         && fams.Any(f => _selectedFamilyIds.Contains(f)))
            .ToHashSet(StringComparer.Ordinal);

        _series = await Charts.GetSeriesAsync(
            _userId,
            _metric,
            effectivePersonIds,
            _selectedFamilyIds);

        // Build a simple integer-age table from actual points.
        var ages = _series.SelectMany(s => s.Points)
            .Select(p => (int)Math.Floor(p.AgeYears))
            .Distinct()
            .OrderBy(a => a)
            .ToList();
        _tableAges = ages;
    }

    private string FormatValue(double v)
        => _metric == ChartMetrics.Weight
            ? UnitConverter.FormatWeight(v, _unitSystem)
            : UnitConverter.FormatHeight(v, _unitSystem);

    private string FiltersSummary
    {
        get
        {
            var people = _selectedPersonIds.Count;
            var metric = _metric;
            var axis = _mode == CompareModes.OverTime
                ? (_xAxis == ChartXAxisModes.Age ? "Age" : "Date")
                : $"Age {_selectedAge:0.#}";
            return $"{people} {(people == 1 ? "person" : "people")} · {metric} · {axis}";
        }
    }

    private double MinAge => 0;

    private double MaxAge
    {
        get
        {
            var max = _series.SelectMany(s => s.Points).Select(p => p.AgeYears).DefaultIfEmpty(18).Max();
            return Math.Max(1, Math.Ceiling(max));
        }
    }

    private sealed class SameAgeRow
    {
        public string PersonId { get; set; } = string.Empty;
        public string PersonName { get; set; } = string.Empty;
        public double? Value { get; set; }
    }

    private List<SameAgeRow> _sameAgeRows
    {
        get
        {
            var rows = new List<SameAgeRow>();
            foreach (var s in _series)
            {
                var nearest = s.Points
                    .Where(p => Math.Abs(p.AgeYears - _selectedAge) <= AgeToleranceYears)
                    .OrderBy(p => Math.Abs(p.AgeYears - _selectedAge))
                    .FirstOrDefault();

                rows.Add(new SameAgeRow
                {
                    PersonId = s.PersonId,
                    PersonName = s.PersonName,
                    Value = nearest?.Y
                });
            }
            return rows.OrderByDescending(r => r.Value ?? double.MinValue).ToList();
        }
    }

    private List<SameAgeRow> _rankedSameAgeRows
        => _sameAgeRows.Where(r => r.Value is not null).ToList();

    private List<SameAgeRow> _missingSameAgeRows
        => _sameAgeRows.Where(r => r.Value is null).ToList();

    private double _sameAgeMaxValue
        => _rankedSameAgeRows.Select(r => r.Value!.Value).DefaultIfEmpty(1).Max();

    private double BarWidthPercent(double value)
    {
        var max = _sameAgeMaxValue;
        if (max <= 0) return 0;
        // Scale to the max value in the ranked set so the tallest/heaviest
        // person fills the track and everyone else is proportional to them.
        return Math.Max(2, value / max * 100);
    }

    // Same palette as LineChart so same-age bars and the over-time chart
    // use identical colors for the same person.
    private static readonly string[] Palette =
    {
        "#1d4ed8", "#dc2626", "#15803d", "#b45309", "#7e22ce",
        "#0e7490", "#be185d", "#4d7c0f", "#c2410c", "#4338ca"
    };

    private static string ColorFor(string personId)
    {
        var hash = 0;
        foreach (var c in personId) hash = (hash * 31 + c) & 0x7fffffff;
        return Palette[hash % Palette.Length];
    }
}

<style>
    .compare-toolbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        flex-wrap: wrap;
        margin-bottom: 0.75rem;
    }

    .compare-toolbar-controls {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .compare-inline-label {
        font-size: 0.85rem;
        color: var(--muted);
        margin: 0;
    }

    .compare-inline-select {
        width: auto;
        min-width: 7rem;
    }

    .compare-filters {
        margin-bottom: 1rem;
        border: 1px solid var(--border);
        border-radius: var(--radius);
        background: var(--surface);
    }

    .compare-filters-toggle {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        width: 100%;
        padding: 0.6rem 0.9rem;
        background: none;
        border: none;
        font: inherit;
        font-weight: 600;
        color: var(--text);
        cursor: pointer;
        text-align: left;
    }

    .compare-filters-summary {
        font-weight: 400;
        font-size: 0.85rem;
        color: var(--muted);
    }

    .compare-filters-body {
        padding: 0 0.9rem 0.9rem;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .compare-filter-heading {
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: var(--muted);
        margin-bottom: 0.25rem;
    }

    .compare-chart-area {
        margin-bottom: 1rem;
    }

    /* The chart card must render identically to the Dashboard snapshot.
       Do not add Compare-only overrides that lighten strokes, reduce
       opacity, or shrink markers. */
    .compare-chart-area .chart-card {
        padding: 1rem 1rem 0.75rem;
    }

    .compare-chart-title {
        margin-top: 0.25rem;
        margin-bottom: 0.5rem;
    }

    .same-age-plot {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        margin-bottom: 1.5rem;
    }

    .same-age-row {
        display: grid;
        grid-template-columns: 1.75rem minmax(8rem, 12rem) 1fr 5.5rem;
        align-items: center;
        gap: 0.75rem;
    }

    .same-age-rank {
        font-size: 0.8rem;
        font-weight: 600;
        color: #6b7280;
        text-align: right;
    }

    .same-age-name {
        font-weight: 500;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .same-age-bar-track {
        position: relative;
        height: 1.5rem;
        background: #f1f3f5;
        border-radius: 0.375rem;
        overflow: hidden;
    }

    .same-age-bar {
        height: 100%;
        border-radius: 0.375rem;
        transition: width 0.2s ease;
    }

    .same-age-value {
        font-variant-numeric: tabular-nums;
        font-weight: 600;
        text-align: right;
        white-space: nowrap;
    }

    .same-age-missing-section {
        margin-top: 1rem;
        padding: 0.75rem 1rem;
        background: #f8f9fa;
        border-radius: 0.5rem;
        color: #6b7280;
    }

    .same-age-missing-heading {
        font-size: 0.95rem;
        font-weight: 600;
        margin: 0 0 0.5rem 0;
        color: #6b7280;
    }

    .same-age-missing-list {
        margin: 0;
        padding-left: 1.25rem;
    }

    .same-age-missing-list li {
        margin: 0.15rem 0;
    }
</style>
